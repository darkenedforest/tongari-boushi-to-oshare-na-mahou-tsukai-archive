---
const base = import.meta.env.BASE_URL;
const rev0 = `${base}/patches/tongari-boushi-en-v2.4.3-beta-rev0.xdelta`;
const rev1 = `${base}/patches/tongari-boushi-en-v2.4.3-beta-rev1.xdelta`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="viewport" content="width=device-width" />
    <title>v2.4.3 Beta — Internal Testing</title>
    <style>
      body {
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        max-width: 480px;
        margin: 80px auto;
        padding: 0 24px;
        color: #222;
        line-height: 1.5;
      }
      h1 {
        font-size: 1.5rem;
        margin: 0 0 16px;
      }
      p {
        margin: 0 0 24px;
        color: #555;
      }
      a.dl {
        display: block;
        padding: 16px 20px;
        margin-bottom: 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        text-decoration: none;
        color: #222;
        font-weight: 600;
      }
      a.dl:hover {
        background: #f4f4f4;
      }
    </style>
  </head>
  <body>
    <h1>v2.4.3 Beta — Internal Testing</h1>
    <p>Beta build with UCC translation fixes (trend rankings menu, shop items, recipe categories). Pick the revision matching your source ROM:</p>
    <a class="dl" href={rev0} download>Rev 0 patch (.xdelta)</a>
    <a class="dl" href={rev1} download>Rev 1 patch (.xdelta)</a>
  </body>
</html>
