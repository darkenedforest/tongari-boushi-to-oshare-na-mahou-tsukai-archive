  { op: 0x0000, full: 0x8000, name: 'COLOR',        cat: 'F', args: 1, count: 24540, verify: 'csv',     note: 'Text color. Args: 1=red, 2=orange, 3=green, 4=blue, 5=yellow, 6=gray, 8=pink, 0=default' },
