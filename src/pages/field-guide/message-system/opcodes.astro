  { op: 0x0004, full: 0x8004, name: 'CODE_8004',    cat: 'F', args: 1, count: 30,    verify: 'csv',     note: 'Formatting variant.' },
  { op: 0x0008, full: 0x8008, name: 'CODE_8008',    cat: 'U', args: 1, count: 5,     verify: 'csv',     note: '3 param variants.' },
