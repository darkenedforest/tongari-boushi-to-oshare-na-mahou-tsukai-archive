const CAT_LABEL: Record<string,string> = {
  F: 'Formatting', S: 'Substitution', D: 'Dialog', M: 'Menu',
  C: 'Flow', X: 'Script', P: 'Display', U: 'Unknown',
};
const VERIFY_LABEL: Record<string,string> = {
  verified: 'verified',
  dispatch: 'dispatch traced',
  csv: 'corpus only',
};
const hex4 = (n:number) => '0x' + n.toString(16).padStart(4, '0');
const total = OPCODES.reduce((s,o)=>s+(o.count||0), 0);
---

<FieldGuideLayout
  title="Opcode catalog"
  description="All 88 inline-CMD opcodes observed in the message corpus, with hex value, arg count, dispatch verification, and frequency."
  crumbs={[
    { label: 'Field Guide', href: `${base}/field-guide/` },
    { label: 'Message System', href: `${base}/field-guide/message-system/` },
    { label: 'Opcodes' },
  ]}
>
  <p>
    Opcodes appear inside <code>INLINE_CMD</code> tokens as the second u16:
    <code>0x0024 (opcode | 0x8000) [0x0027 (arg | 0x8000)]* 0x003B [data... 0x0000]</code>.
    The <code>op</code> column is the opcode value <code>(word &amp; 0x7FFF)</code>;
    the <code>wire</code> column is the literal u16 you find in the file.
    <code>{total.toLocaleString()}</code> CMDs counted across 50,196 non-empty entries in 1,328 message files.
  </p>

  <h2>Verification levels</h2>
  <ul>
    <li><code>verified</code> — parser handler decompiled; opcode's effect on
      <code>line.flags</code> / sub-handler dispatch confirmed.</li>
    <li><code>dispatch traced</code> — opcode known to route to
      <code>FUN_02057754</code> (the registry-99 substitution table);
      specific output verified by in-game test.</li>
    <li><code>corpus only</code> — semantics from user gameplay testing or
      inferred from surrounding text; not yet confirmed by static analysis.</li>
  </ul>

  <h2>Categories</h2>
  <table>
    <thead><tr><th>Code</th><th>Name</th><th>Meaning</th></tr></thead>
    <tbody>
      <tr><td><code>F</code></td><td>Formatting</td><td>Color, font, inline style</td></tr>
      <tr><td><code>S</code></td><td>Substitution</td><td>Inserts runtime data (player name, NPC name, item, etc.)</td></tr>
      <tr><td><code>D</code></td><td>Dialog</td><td>Textbox layout, speaker portrait, expression — header-like config</td></tr>
      <tr><td><code>M</code></td><td>Menu</td><td>Choice list structure</td></tr>
      <tr><td><code>C</code></td><td>Flow</td><td>Branching, conditional, line-flag mode select</td></tr>
      <tr><td><code>X</code></td><td>Script</td><td>Engine script call / marker</td></tr>
      <tr><td><code>P</code></td><td>Display</td><td>Renderer-side display control (close box, wait, separator)</td></tr>
      <tr><td><code>U</code></td><td>Unknown</td><td>Function not yet identified</td></tr>
    </tbody>
  </table>

  <h2>Width budgets (text substitution)</h2>
  <p>
    For length-fitting EN translations, the substitution opcodes carry a
    character-width budget when the engine inlines their output:
  </p>
  <table>
    <thead><tr><th>Tag form</th><th>Opcode</th><th>Width (chars)</th><th>Source</th></tr></thead>
    <tbody>
      <tr><td><code>[PLAYER_NAME]</code></td><td><code>0x01F4</code></td><td>10</td><td>Save slot, user input</td></tr>
      <tr><td><code>[SCHOOL_NAME]</code></td><td><code>0x01F8</code></td><td>10</td><td>Save data</td></tr>
      <tr><td><code>[NAME:{`<id>`}]</code></td><td><code>0x01F7</code></td><td>≤12 (longest canon NPC)</td><td>NpcDataOfs[id]</td></tr>
      <tr><td><code>[ITEM:{`<id>`}]</code></td><td><code>0x01FB</code></td><td>≤24</td><td>itemname.ofs[id]</td></tr>
      <tr><td><code>[PARTICLE:{`<slot>`}]</code></td><td><code>0x01FF</code></td><td>≤6</td><td>NpcDataOfs +0x5C+(slot*0x10)</td></tr>
      <tr><td><code>[NPC_DAT:0]</code></td><td><code>0x0202</code></td><td>≤6 (pronoun)</td><td>NpcDataOfs +0x20</td></tr>
      <tr><td><code>[NPC_DAT:1]</code></td><td><code>0x0202</code></td><td>standalone phrase</td><td>NpcDataOfs +0x2C</td></tr>
      <tr><td><code>[CHOICES:99]</code></td><td><code>0x0205</code></td><td>20</td><td>Runtime context (object/item)</td></tr>
      <tr><td><code>[GUEST:{`<n>`}]</code></td><td><code>0x01F5</code></td><td>10</td><td>Guest slot (0..3)</td></tr>
    </tbody>
  </table>

  <h2>Full opcode table</h2>
  <p>Sorted by hex value:</p>
  <table>
    <thead>
      <tr>
        <th>op</th><th>wire</th><th>name</th><th>cat</th><th>args</th>
        <th>count</th><th>verify</th><th>notes</th>
      </tr>
    </thead>
    <tbody>
      {OPCODES.sort((a,b)=>a.op-b.op).map(o => (
        <tr>
          <td><code>{hex4(o.op)}</code></td>
          <td><code>{hex4(o.full)}</code></td>
          <td><code>{o.name}</code></td>
          <td>{CAT_LABEL[o.cat]}</td>
          <td>{String(o.args)}</td>
          <td>{(o.count||0).toLocaleString()}</td>
          <td>{VERIFY_LABEL[o.verify]}</td>
          <td>{o.note}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Parser-visible opcodes</h2>
  <p>
    These six opcodes affect the parser <code>FUN_02066c58</code> directly
    (line-flag mutation or sub-handler dispatch). Everything else is forwarded
    to the renderer.
  </p>
  <table>
    <thead><tr><th>Opcode</th><th>Parser effect</th></tr></thead>
    <tbody>
      <tr><td><code>0x37</code></td><td>HEADER. Only valid as first CMD; reads 1–2 typed args between <code>0x27</code> separators.</td></tr>
      <tr><td><code>0x10</code></td><td><code>line.flags = (flags &amp; 0xF0) | 3</code> (arg-mode 3 — name field)</td></tr>
      <tr><td><code>0x11</code></td><td><code>line.flags = (flags &amp; 0xF0) | 2</code></td></tr>
      <tr><td><code>0x12</code></td><td><code>line.flags = (flags &amp; 0xF0) | 1</code></td></tr>
      <tr><td><code>0x13</code></td><td><code>line.flags &amp;= 0xF0</code> (clear low nibble — no-arg mode)</td></tr>
      <tr><td><code>0x4C</code></td><td>Sub-handler <code>FUN_0206726C</code>: reads 2 typed args, stores at <code>line.args[0xA..0xF]</code>, OR-sets bit 4 of <code>line.flags</code>.</td></tr>
    </tbody>
  </table>

  <h2>Sources</h2>
  <ul>
    <li><code>notes/opcode_master_reference.md</code> — full corpus census</li>
