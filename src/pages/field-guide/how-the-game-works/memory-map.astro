---
import FieldGuideLayout from '../../../components/FieldGuideLayout.astro';
const base = import.meta.env.BASE_URL;
---

<FieldGuideLayout
  title="ARM9 memory map"
  description="Where each region of ARM9 RAM lives in the running game. Code, BSS, overlay slots, VRAM/OAM hardware bases."
  crumbs={[
    { label: 'Field Guide', href: `${base}/field-guide/` },
    { label: 'How the Game Works', href: `${base}/field-guide/how-the-game-works/` },
    { label: 'Memory map' },
  ]}
>
  <h2>ARM9 RAM regions</h2>
  <table>
    <thead><tr><th>Range</th><th>Size</th><th>Role</th></tr></thead>
    <tbody>
      <tr><td><code>0x02000000..0x02000800</code></td><td>2 KB</td><td>Secure-area / boot init (ARM mode, encrypted on disk)</td></tr>
      <tr><td><code>0x02000800</code></td><td>—</td><td>Entry point (ARM mode, switches to THUMB ~<code>0x02001000</code>)</td></tr>
      <tr><td><code>0x02000000..0x020A87A0</code></td><td>723 KB</td><td>ARM9 text + data (plaintext after BLZ decompress)</td></tr>
      <tr><td><code>0x020A1000..0x020A8000</code></td><td>28 KB</td><td>Path string region (131 unique paths into RESO containers)</td></tr>
      <tr><td><code>0x020A6E44..0x020A6F88</code></td><td>~324 B</td><td>ARM9 menu string pool (26 strings). See <a href={`${base}/field-guide/names-and-words/arm9-menu-pool/`}>ARM9 menu pool</a>.</td></tr>
      <tr><td><code>0x020A7XXX</code></td><td>—</td><td>BSS managers (<code>0x020A749C</code> OAM manager pointer + 41 refs)</td></tr>
      <tr><td><code>0x020A87A0..0x02125420</code></td><td>~512 KB</td><td>ARM9 BSS</td></tr>
      <tr><td><code>0x020AA740</code></td><td>—</td><td>Master content-cache table (712 references)</td></tr>
      <tr><td><code>0x02125420..0x02155A00</code></td><td>—</td><td>Overlay BSS / persistent</td></tr>
      <tr><td><code>0x02155A00..0x021570A0</code></td><td>—</td><td>Shared overlay slot 1 — 66 game-mode controllers</td></tr>
      <tr><td><code>0x021597A0..0x021643E0</code></td><td>—</td><td>Shared overlay slot 2 — 25 body / renderer</td></tr>
      <tr><td><code>0x0215C540..0x0215DE40</code></td><td>—</td><td>Shared overlay slot 3 — 20 bodies</td></tr>
      <tr><td><code>0x0216DA40..0x0218E2A0</code></td><td>132 KB</td><td>ov137 (2D engine) or ov138 (3D map)</td></tr>
      <tr><td><code>0x02190768..0x02190A00</code></td><td>—</td><td>ov137 OAM manager state (sprite-slot array etc.)</td></tr>
      <tr><td><code>0x021A55C0</code></td><td>—</td><td>Game state struct pointer (750 references)</td></tr>
      <tr><td><code>0x021B6080..0x021C3420</code></td><td>—</td><td>Shared overlay slot 4 (ov156/157)</td></tr>
      <tr><td><code>0x021C3420..0x021FB320</code></td><td>—</td><td>Shared overlay slot 5 (ov158/159)</td></tr>
      <tr><td><code>0x021FB3C0..0x02201000</code></td><td>—</td><td>Shared overlay slot 6 — 18 overlays</td></tr>
      <tr><td><code>0x023FFE00..0x023FFFFC</code></td><td>~512 B</td><td>Stack region (per NDS spec)</td></tr>
      <tr><td><code>0x027E0000+</code></td><td>—</td><td>ARM7 shared work RAM (used by VBlank)</td></tr>
    </tbody>
  </table>

  <h2>NDS hardware (referenced from ARM9 code)</h2>
  <table>
    <thead><tr><th>Address</th><th>Role</th></tr></thead>
    <tbody>
      <tr><td><code>0x040000B0..0x040000BC</code></td><td>DMA0 source / dest / count / control</td></tr>
      <tr><td><code>0x04000050</code></td><td>BLDCNT — blend control (used in <code>FUN_02181D24</code>)</td></tr>
      <tr><td><code>0x04000208</code></td><td>IME — interrupt master enable</td></tr>
      <tr><td><code>0x05000000</code></td><td>BG palette main</td></tr>
      <tr><td><code>0x05000400</code></td><td>BG palette sub</td></tr>
      <tr><td><code>0x06000000..0x06FFFFFF</code></td><td>VRAM (BG + OBJ)</td></tr>
      <tr><td><code>0x06400000</code></td><td>OBJ VRAM main</td></tr>
      <tr><td><code>0x06600000</code></td><td>OBJ VRAM sub</td></tr>
      <tr><td><code>0x07000000</code></td><td>OAM main HW (1 reference in arm9 init only)</td></tr>
      <tr><td><code>0x07000400</code></td><td>OAM sub HW</td></tr>
    </tbody>
  </table>

  <h2>ROM layout</h2>
  <table>
    <thead><tr><th>Range</th><th>Size</th><th>Content</th></tr></thead>
    <tbody>
      <tr><td><code>0x4000</code></td><td>—</td><td>ARM9 (BLZ-compressed; 564,488 bytes = <code>0x89D08</code>)</td></tr>
      <tr><td><code>0x8DE00</code></td><td><code>0x1680</code></td><td>Overlay table — 180 entries × 32 bytes</td></tr>
      <tr><td><code>0x239600</code></td><td><code>0x91E5</code></td><td>FNT (filename table)</td></tr>
      <tr><td><code>0x242800</code></td><td><code>0x52C8</code></td><td>FAT (file allocation table)</td></tr>
      <tr><td>—</td><td>—</td><td>2,649 total files</td></tr>
    </tbody>
  </table>

  <h2>Notable BSS globals</h2>
  <table>
    <thead><tr><th>Address</th><th>Refs</th><th>Role</th></tr></thead>
    <tbody>
      <tr><td><code>0x020A749C</code></td><td>42</td><td>ARM9 OAM manager pointer</td></tr>
      <tr><td><code>0x020AA740</code></td><td>712</td><td>Master content-cache table</td></tr>
      <tr><td><code>0x02190768</code>, <code>0x02190764</code>, <code>0x02190840</code>, <code>0x02190A00</code></td><td>—</td><td>Additional OAM-related BSS managers</td></tr>
      <tr><td><code>0x021907BC</code></td><td>28 writes</td><td>ov137 sprite-slot array pointer</td></tr>
      <tr><td><code>0x021907C0</code>, <code>0x021908A4</code>, <code>0x021908B4</code>, <code>0x021908B8</code>, <code>0x021908BC</code>, <code>0x021908C8</code></td><td>—</td><td>Further sprite/OAM managers</td></tr>
      <tr><td><code>0x02190908</code></td><td>—</td><td>ov137 OAM manager pointer</td></tr>
      <tr><td><code>0x021A55C0</code></td><td>750</td><td>Game state struct pointer (top-most reference)</td></tr>
    </tbody>
  </table>

  <h2>Source</h2>
  <ul>
    <li><code>notes/phaseA_ghidra/DISCOVERIES.md</code> §"Memory map"</li>
    <li><code>arm9_full_plaintext.bin</code> — module-params decoded for region boundaries</li>
  </ul>
</FieldGuideLayout>
