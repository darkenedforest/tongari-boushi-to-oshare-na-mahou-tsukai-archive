---
import FieldGuideLayout from '../../../components/FieldGuideLayout.astro';
import subRecords from '../../../data/ucc_subrecords.json';
const base = import.meta.env.BASE_URL;

type Sub = { slot:number; sub:number; hdr:string; jp:string; en:string };
const subs = subRecords as Sub[];
const bySlot: Record<number, Sub[]> = {};
for (const r of subs) {
  if (!bySlot[r.slot]) bySlot[r.slot] = [];
  bySlot[r.slot].push(r);
}
const SLOT_FAMILY: Record<number, string> = {
  57:  'Cake / ショートケーキ',
  65:  'Stew / クリームシチュー',
  66:  'Stew / ビーフシチュー',
  101: 'Ice / バニラアイス',
  144: 'Bread / あんぱん',
  145: 'Bread / チョコパン',
  146: 'Bread / クリームパン',
  149: 'Bread / ジャムパン',
  151: 'Pasta / カルボナーラ',
  152: 'Pasta / ナポリタン',
};
---

<FieldGuideLayout
  title="UCC food recipe slots"
  description="data/ucc/names.ofs multi-name slot format: 68-byte sub-records keyed by a 2-byte ingredient pair."
  crumbs={[
    { label: 'Field Guide', href: `${base}/field-guide/` },
    { label: 'Names & Words', href: `${base}/field-guide/names-and-words/` },
    { label: 'Food recipes' },
  ]}
>
  <p>
    <code>extracted/nds/data/ucc/names.ofs</code> is a
    <a href={`${base}/field-guide/file-formats/reso/`}>RESO</a> container,
    variant=1, with 192 slots totalling 11,376 bytes. Most slots are simple
    68-byte name records; <strong>10 slots</strong> are "multi-name" arrays
    of 68-byte sub-records.
  </p>

  <h2>Simple slot (68 bytes)</h2>
  <table>
    <thead><tr><th>Offset</th><th>Size</th><th>Type</th><th>Field</th></tr></thead>
    <tbody>
      <tr><td><code>+0x00</code></td><td>2</td><td><code>u16</code></td><td>state_code_lo</td></tr>
      <tr><td><code>+0x02</code></td><td>2</td><td><code>u16</code></td><td>state_code_hi (0x0000 for multi)</td></tr>
      <tr><td><code>+0x04</code></td><td>64</td><td>UTF-16-LE</td><td>name + <code>0x0000</code> terminator + NUL pad</td></tr>
    </tbody>
  </table>

  <h2>Multi-name slot layout</h2>
  <p>
    Multi-name slot length is always a multiple of 68 bytes. Sub-record [0]
    is the category/base name; sub-records [1..N-1] are recipe variants
    keyed by the 2-byte ingredient-pair code at <code>+0x00</code>.
    The engine selects a variant by matching the player's ingredient pair
    against each sub-record's key.
  </p>

  <h2>Multi-name slot inventory</h2>
  <table>
    <thead>
      <tr>
        <th>Slot</th>
        <th>Length</th>
        <th>N sub-records</th>
        <th>Base name (JP)</th>
        <th>Variant family</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>57</td><td>136</td><td>2</td><td>ケーキ</td><td>ショートケーキ</td></tr>
      <tr><td>65</td><td>680</td><td>10</td><td>シチュー</td><td>クリームシチュー</td></tr>
      <tr><td>66</td><td>408</td><td>6</td><td>シチュー</td><td>ビーフシチュー</td></tr>
      <tr><td>101</td><td>136</td><td>2</td><td>アイス</td><td>バニラアイス</td></tr>
      <tr><td>144</td><td>136</td><td>2</td><td>パン</td><td>あんぱん</td></tr>
      <tr><td>145</td><td>340</td><td>5</td><td>パン</td><td>チョコパン</td></tr>
      <tr><td>146</td><td>136</td><td>2</td><td>パン</td><td>クリームパン</td></tr>
      <tr><td>149</td><td>136</td><td>2</td><td>パン</td><td>ジャムパン</td></tr>
      <tr><td>151</td><td>612</td><td>9</td><td>パスタ</td><td>カルボナーラ</td></tr>
      <tr><td>152</td><td>612</td><td>9</td><td>パスタ</td><td>ナポリタン</td></tr>
    </tbody>
  </table>
  <p>Total sub-records: 49 (10 base + 39 variants), 3,332 bytes.</p>

  <h2>Worked example — Slot 57 (Cake)</h2>
  <pre><code>{`[0] hdr=05000000  name='ケーキ'           (category root; simple-slot-style header 0x0005)
[1] hdr=55550000  name='ショートケーキ'   (variant; key = ASCII 'UU' / 0x55,0x55)`}</code></pre>

  <h2>Worked example — Slot 65 (Cream Stew, alphabet {`{3,7,8,9}`})</h2>
  <pre><code>{`[0] hdr=05060000  name='シチュー'           (root)
[1] hdr=37390000  name='クリームシチュー'   key '79'  (= 0x37,0x39)
[2] hdr=39370000  name='クリームシチュー'   key '97'
[3] hdr=37380000  name='クリームシチュー'   key '78'
[4] hdr=38370000  name='クリームシチュー'   key '87'
[5] hdr=38390000  name='クリームシチュー'   key '89'
[6] hdr=39380000  name='クリームシチュー'   key '98'
[7] hdr=33370000  name='クリームシチュー'   key '37'
[8] hdr=33390000  name='クリームシチュー'   key '39'
[9] hdr=33380000  name='クリームシチュー'   key '38'`}</code></pre>
  <p>
    All 9 variant names are identical JP text; only the 2-byte key differs.
    The 9 keys cover the non-equal ordered pairs over alphabet
    <code>{`{3,7,8,9}`}</code> where at least one digit is from
    <code>{`{3}`}</code> plus a partner in <code>{`{7,8,9}`}</code>, or any
    ordered pair of distinct digits in <code>{`{7,8,9}`}</code>.
  </p>

  <h2>Re-emit constraint</h2>
  <p>
    The RESO container is reflowed on rebuild — per-slot length is recomputed
    from actual payload. <strong>However</strong>, within a multi-name slot
    the engine indexes sub-records at fixed 68-byte strides. Therefore:
  </p>
  <ul>
    <li>Every sub-record must remain exactly 68 bytes.</li>
    <li>Bytes <code>+0x00..+0x03</code> (the recipe-pair key) must be
      preserved byte-for-byte.</li>
    <li>EN name fits in 60 bytes (30 UTF-16 code units, then NUL).</li>
    <li>Sub-record count per slot must stay at N (each variant key must
      keep its slot).</li>
  </ul>

  <h2>All sub-records</h2>
  {Object.keys(bySlot).sort((a:any,b:any)=>(a-b)).map((slotKey:any) => {
    const slot = Number(slotKey);
    return (
      <>
        <h3>Slot {slot} — {SLOT_FAMILY[slot] || ''}</h3>
        <table>
          <thead><tr><th>sub</th><th>header (hex)</th><th>JP</th><th>EN</th></tr></thead>
          <tbody>
            {bySlot[slot].map(r => (
              <tr>
                <td><code>{r.sub}</code></td>
                <td><code>{r.hdr}</code></td>
                <td><code>{r.jp}</code></td>
                <td><strong>{r.en || ''}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    );
  })}

  <h2>Source</h2>
  <ul>
    <li><code>notes/ucc_food_format.md</code> — full decode + inventory</li>
    <li><code>notes/ucc_food_inventory.txt</code> — raw sub-record dump</li>
    <li><code>extracted/scratch/db/translation.sqlite</code> — <code>ucc_food_subrecords</code> table</li>
  </ul>
</FieldGuideLayout>
