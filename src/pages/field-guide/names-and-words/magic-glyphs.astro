---
import FieldGuideLayout from '../../../components/FieldGuideLayout.astro';
import data from '../../../data/magic_glyphs.json';
const base = import.meta.env.BASE_URL;

type Glyph = { idx:number; jp:string; en:string; src:string };
const rows = data as Glyph[];
const counts = rows.reduce((acc:Record<string,number>, r) => {
  acc[r.src] = (acc[r.src] || 0) + 1;
  return acc;
}, {});
const SRC_LABEL: Record<string,string> = {
  canon: 'Konami Game 1 canon',
  npc: 'NPC name DB',
  placeholder: 'NPC DB placeholder',
  universal: 'Dictionary',
  fresh: 'Fresh translation',
};
---

<FieldGuideLayout
  title="Magic glyph dictionary"
  description={`The 377 populated slots in 2d/inputmagic/msg.ofs (RESO variant=1, 1000 slots). Each glyph is one word the player can place in a spell.`}
  crumbs={[
    { label: 'Field Guide', href: `${base}/field-guide/` },
    { label: 'Names & Words', href: `${base}/field-guide/names-and-words/` },
    { label: 'Magic glyphs' },
  ]}
>
  <h2>Slot table format</h2>
  <p>
    <code>data/2d/inputmagic/msg.ofs</code> is a <a href={`${base}/field-guide/file-formats/reso/`}>RESO</a>
    container, variant=1, file_count=1000. Slots are addressable as
    <code>slot_index ∈ [0, 999]</code>; 377 are populated. Each populated
    payload is a UTF-16-LE Japanese word terminated by <code>0x0000</code>.
    No CMD opcodes; no header.
  </p>

  <h2>Asset references</h2>
  <table>
    <thead><tr><th>Resource</th><th>File</th><th>Notes</th></tr></thead>
    <tbody>
      <tr><td>Slot text (JP)</td><td><code>2d/inputmagic/msg.ofs</code></td><td>RESO variant=1, 1000 slots, 377 populated</td></tr>
      <tr><td>Atlas icons (4bpp NCGRs)</td><td><code>2d/inputmagic/mgcall.ofs</code></td><td>389 NCGRs</td></tr>
      <tr><td>Individual icons</td><td><code>2d/inputmagic/mgc01..09c.lzs</code></td><td>434 NCGRs</td></tr>
      <tr><td>Palette (16-color)</td><td><code>2d/inputmagic/mgc80.ofs</code> entry 0</td><td>Shared by all glyph NCGRs. Entry 2 = alt scheme.</td></tr>
      <tr><td>Keyboard composition</td><td><code>2d/inputmagic/input.lzs</code> NCER ents 17/18/19</td><td>NCER cells</td></tr>
    </tbody>
  </table>

  <h2>Cross-game canon coverage</h2>
  <p>
    EN names sourced by walking, in order: Konami Game 1 (Magician's Quest)
    parallel-indexed corpus → NPC name DB → dictionary translations → fresh
    decision. Sources are listed in the <code>source</code> column below.
  </p>
  <table>
    <thead><tr><th>Source</th><th>Count</th></tr></thead>
    <tbody>
      {Object.entries(counts).sort((a:any,b:any)=>b[1]-a[1]).map(([k,v]) => (
        <tr><td>{SRC_LABEL[k] || k}</td><td>{v}</td></tr>
      ))}
      <tr><td><strong>Total populated</strong></td><td><strong>{rows.length}</strong></td></tr>
    </tbody>
  </table>

  <h2>Full slot table</h2>
  <p>Sorted by <code>slot_index</code>.</p>
  <table>
    <thead><tr><th>idx</th><th>JP</th><th>EN</th><th>source</th></tr></thead>
    <tbody>
      {rows.map(r => (
        <tr>
          <td><code>{r.idx}</code></td>
          <td><code>{r.jp}</code></td>
          <td><strong>{r.en}</strong></td>
          <td>{SRC_LABEL[r.src] || r.src}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>How this file was found</h2>
  <p>
    <code>2d/inputmagic/msg.ofs</code> was discovered during the msg-file
    audit. The audit walked every RESO container under <code>data/</code>
    looking for ones that carried untranslated UTF-16 payloads and weren't
    yet on the project's known-files list. <code>msg.ofs</code> stood out
    because its payloads were all single-word: greetings, magic words,
    emotional states, yes/no — exactly the vocabulary you'd expect behind
    the in-game "type a magic word" feature. Before the audit, this file
    had never been extracted; the 377 glyphs were all locked inside the
    container.
  </p>

  <h2>Source</h2>
  <ul>
    <li><code>notes/magic_glyph_ref.md</code> — full reference table</li>
    <li><code>extracted/scratch/db/translation.sqlite</code> — <code>magic_glyphs</code> table</li>
    <li>Game 1: <code>picstat/magic/msg_e.dat</code> — Konami EN corpus</li>
  </ul>
</FieldGuideLayout>
