  { off:'0xa6e64', slot: 8, en:'End',     src:'canon-mine', co:true,  jp:'やめる (G1: Exit/Quit)' },
  { off:'0xa6e6c', slot: 8, en:'Hum',     src:'fresh',      co:false, jp:'うたう (sing; Sing overflows by 1)' },
