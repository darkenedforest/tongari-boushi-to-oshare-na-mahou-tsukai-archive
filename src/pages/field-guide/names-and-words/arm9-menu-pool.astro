  { off:'0xa6eb4', slot:12, en:'Equip',   src:'canon-G1',   co:false, jp:'みにつける ✓' },
  { off:'0xa6ec0', slot:12, en:'10 R',    src:'canon-mine', co:true,  jp:'１０リッチ' },
  { off:'0xa6ecc', slot:12, en:'Walls',   src:'canon-mine', co:true,  jp:'かべかえる (G1: Change wallpaper)' },
  { off:'0xa6ed8', slot:12, en:'Floor',   src:'canon-mine', co:true,  jp:'ゆかかえる (G1: Change flooring)' },
