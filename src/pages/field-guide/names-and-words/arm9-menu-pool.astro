  { off:'0xa6f14', slot:16, en:'Hat off', src:'canon-mine', co:true,  jp:'ぼうしはずす (G1: Remove hat)' },
  { off:'0xa6f24', slot:16, en:'No spex', src:'canon-mine', co:true,  jp:'めがねはずす (G1: Remove glasses)' },
  { off:'0xa6f34', slot:16, en:'100 R',   src:'canon-mine', co:true,  jp:'１００リッチ' },
