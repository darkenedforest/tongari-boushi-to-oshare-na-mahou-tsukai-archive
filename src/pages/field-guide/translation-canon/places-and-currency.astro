---
import FieldGuideLayout from '../../../components/FieldGuideLayout.astro';
const base = import.meta.env.BASE_URL;
---

<FieldGuideLayout
  title="Places, currency, royal titles"
  description="Project-level naming canon for non-character nouns. Currency is Ritch; royal title is His Majesty; class name in academic contexts is Linguistics."
  crumbs={[
    { label: 'Field Guide', href: `${base}/field-guide/` },
    { label: 'Translation Canon', href: `${base}/field-guide/translation-canon/` },
    { label: 'Places & currency' },
  ]}
>
  <h2>Currency</h2>
  <table>
    <thead><tr><th>JP</th><th>EN canon</th><th>Source</th><th>Notes</th></tr></thead>
    <tbody>
      <tr><td><code>リッチ</code></td><td><strong>Ritch</strong></td><td>canon-G1</td><td>66 corpus hits in Game 1. NOT "Mira".</td></tr>
      <tr><td><code>１リッチ</code></td><td><strong>1 R</strong></td><td>budget-fit</td><td>Width-3 ARM9 slot.</td></tr>
      <tr><td><code>１０リッチ</code></td><td><strong>10 R</strong></td><td>budget-fit</td><td>Width-4 slot.</td></tr>
      <tr><td><code>１００リッチ</code></td><td><strong>100 R</strong></td><td>budget-fit</td><td>Width-5 slot.</td></tr>
      <tr><td><code>１０００リッチ</code></td><td><strong>1000 R</strong></td><td>budget-fit</td><td>Width-6 slot.</td></tr>
      <tr><td><code>１００００リッチ</code></td><td><strong>10000 R</strong></td><td>budget-fit</td><td>Width-7 slot.</td></tr>
      <tr><td><code>１０００００リッチ</code></td><td><strong>100000 Ritch</strong></td><td>canon-G1</td><td>Width-12 slot fits full canon.</td></tr>
    </tbody>
  </table>

  <h2>Royal titles</h2>
  <table>
    <thead><tr><th>JP</th><th>EN canon</th><th>Notes</th></tr></thead>
    <tbody>
      <tr><td><code>陛下</code></td><td><strong>His Majesty</strong></td><td>The king is male; honorific form preferred when addressing him.</td></tr>
      <tr><td><code>王様</code></td><td><strong>King</strong></td><td>General reference.</td></tr>
      <tr><td><code>王子</code></td><td><strong>Prince</strong></td><td/></tr>
      <tr><td><code>王女</code></td><td><strong>Princess</strong></td><td/></tr>
    </tbody>
  </table>

  <h2>Class names (academic contexts)</h2>
  <table>
    <thead><tr><th>JP</th><th>EN canon (class context)</th><th>EN (dialog context)</th><th>Notes</th></tr></thead>
    <tbody>
      <tr><td><code>マジック語</code></td><td><strong>Linguistics</strong></td><td>magic language</td><td>Only use "Linguistics" when naming the class itself.</td></tr>
      <tr><td><code>フィールド学</code></td><td><strong>Outdoor class</strong></td><td>outdoor / nature class</td><td/></tr>
      <tr><td><code>ショーの音楽</code></td><td><strong>Show BGM</strong></td><td>show music</td><td>Fits 8-char ARM9 slot.</td></tr>
    </tbody>
  </table>

  <h2>Shops and locations</h2>
  <table>
    <thead><tr><th>JP</th><th>EN canon</th><th>Notes</th></tr></thead>
    <tbody>
      <tr><td><code>とんがり王国</code></td><td><strong>Tongari Kingdom</strong></td><td>Game-3 only. Kingdom name retained from JP.</td></tr>
      <tr><td><code>カメヤ</code></td><td><strong>Kameya</strong></td><td>Magic-supplies shop (Game 1 carryover).</td></tr>
      <tr><td><code>フラワーデイジー</code></td><td><strong>Flower Daisy</strong></td><td>Flower shop.</td></tr>
      <tr><td><code>ベル</code></td><td><strong>Bell</strong></td><td>Map zone name (project decision).</td></tr>
    </tbody>
  </table>

  <h2>Source</h2>
  <ul>
    <li><code>notes/arm9_overlay_translations_final.md</code> §"Currency canon discovery"</li>
    <li><code>notes/applied_project_canon_changes.md</code> — project-wide decisions</li>
    <li><code>notes/project_crossgame_correlation.md</code> — Game 1 / Game 3 anchor logic</li>
  </ul>
</FieldGuideLayout>
