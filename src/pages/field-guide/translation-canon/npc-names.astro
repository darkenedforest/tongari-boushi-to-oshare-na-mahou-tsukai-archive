---
import FieldGuideLayout from '../../../components/FieldGuideLayout.astro';
import npcsData from '../../../data/npc_names.json';
const base = import.meta.env.BASE_URL;

type Npc = { id:number; jp:string; en:string };
const rows = npcsData as Npc[];
---

<FieldGuideLayout
  title="NPC name canon"
  description={`${rows.length} canonised NPC names. Sourced from npc_data.ofs slots + Game 1 (Magician's Quest) Konami EN corpus.`}
  crumbs={[
    { label: 'Field Guide', href: `${base}/field-guide/` },
    { label: 'Translation Canon', href: `${base}/field-guide/translation-canon/` },
    { label: 'NPC names' },
  ]}
>
  <h2>Source data</h2>
  <ul>
    <li>JP slot data: <code>extracted/nds/data/npc/NpcDataOfs.ofs</code> (252 NPC slots).</li>
    <li>EN canon: Konami Game 1 (Magician's Quest) <code>root/npc/NpcName_e.ofs</code> + dialog corpus cross-reference.</li>
    <li>DB table: <code>npc_names</code> in <code>extracted/scratch/db/translation.sqlite</code>.</li>
  </ul>

  <h2>NpcDataOfs record (per NPC)</h2>
  <table>
    <thead><tr><th>Offset</th><th>Size</th><th>Field</th></tr></thead>
    <tbody>
      <tr><td><code>+0x00</code></td><td>32</td><td>npc_name (UTF-16-LE, NUL-padded)</td></tr>
      <tr><td><code>+0x20</code></td><td>12</td><td>pronoun (UTF-16-LE) — first-person speech</td></tr>
      <tr><td><code>+0x2C</code></td><td>48</td><td>catchphrase (UTF-16-LE) — standalone phrase</td></tr>
      <tr><td><code>+0x5C</code></td><td>16×6</td><td>sentence-ender particle slots (PARTICLE 0..5)</td></tr>
    </tbody>
  </table>
  <p>
    Opcode <code>0x01F7</code> (<code>[NAME:id]</code>) looks up the
    <code>npc_name</code> field; <code>0x0202</code> with arg 0 substitutes
    the pronoun, arg 1 substitutes the catchphrase; <code>0x01FF</code>
    (<code>[PARTICLE:n]</code>) reads from the particle slot table at
    <code>+0x5C + n*0x10</code>.
  </p>

  <h2>Canon table — {rows.length} names</h2>
  <table>
    <thead><tr><th>npc_id</th><th>JP</th><th>EN canon</th></tr></thead>
    <tbody>
      {rows.map(r => (
        <tr>
          <td><code>{r.id}</code></td>
          <td><code>{r.jp}</code></td>
          <td><strong>{r.en}</strong></td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Source</h2>
  <ul>
    <li><code>notes/phaseA_ghidra/DISCOVERIES.md</code> §"NPC data"</li>
    <li><code>notes/project_crossgame_correlation.md</code> — Game 1↔Game 3 mapping methodology</li>
    <li><code>extracted/scratch/db/translation.sqlite</code> — <code>npc_names</code> table</li>
  </ul>
</FieldGuideLayout>
