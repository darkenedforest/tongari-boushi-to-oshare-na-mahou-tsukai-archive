---
import FieldGuideLayout from '../../../components/FieldGuideLayout.astro';
const base = import.meta.env.BASE_URL;

type Row = { jp:string; en:string; source:string; notes?:string };
const GLOSSARY: Row[] = [
  // Currency & royal
  { jp: 'リッチ', en: 'Ritch', source: 'canon-G1', notes: 'Currency. 66 corpus hits. NOT "Mira".' },
  { jp: '陛下', en: 'His Majesty', source: 'canon-G1', notes: 'Royal title (king is male).' },
  { jp: '王様', en: 'King', source: 'canon-G1' },
  { jp: '王子', en: 'Prince', source: 'canon-G1' },
  { jp: '王女', en: 'Princess', source: 'canon-G1' },

  // Locations
  { jp: 'とんがり王国', en: 'Tongari Kingdom', source: 'canon-G3' },
  { jp: 'カメヤ', en: 'Kameya', source: 'canon-G1', notes: 'Magic-supplies shop' },
  { jp: 'フラワーデイジー', en: 'Flower Daisy', source: 'canon-G1', notes: 'Flower shop' },

  // Classes / academic
  { jp: 'マジック語', en: 'Linguistics', source: 'canon-G1', notes: 'Magic language class. In class-name contexts only.' },
  { jp: 'まほうの言葉', en: 'magic language', source: 'canon-G1', notes: 'In-dialog reference (not the class name).' },
  { jp: 'フィールド学', en: 'Outdoor class', source: 'canon-G1' },
  { jp: 'ショーの音楽', en: 'Show BGM', source: 'fresh', notes: 'Width-constrained ARM9 slot.' },

  // Game-1 NPC anchors (top character names)
  { jp: 'こうちょう', en: 'Principal Sol', source: 'canon-G1' },
  { jp: 'リカルド', en: 'Mr. Vlad', source: 'canon-G1' },
  { jp: 'ドルイドン', en: 'Mr. Oakley', source: 'canon-G1' },
  { jp: 'ミスキーキー', en: 'Miss Strawe', source: 'canon-G1' },
  { jp: 'ダグラス', en: 'Mr. Graves', source: 'canon-G1' },
  { jp: 'ピカード', en: 'Piquard', source: 'canon-G1' },
  { jp: 'デイジー', en: 'Daisy', source: 'canon-G1' },
  { jp: 'ビビ', en: 'Vivian', source: 'canon-G1' },
  { jp: 'ローリィ', en: 'Roley', source: 'canon-G1' },
  { jp: 'トメ', en: 'Malila', source: 'canon-G1' },
  { jp: 'メルシィ', en: 'Marcy', source: 'canon-G1' },
  { jp: 'ジョージ', en: 'George', source: 'canon-G1' },
  { jp: 'ブニャー', en: 'Thom', source: 'canon-G1' },
  { jp: 'テツ', en: 'Reginald', source: 'canon-G1', notes: 'Cross-game NPC: Tetsu (G3) = Reginald (G1).' },
  { jp: 'ヒゲマル', en: 'Charlie', source: 'canon-G1' },
  { jp: 'マッハ', en: 'Mah', source: 'canon-G1' },

  // Player roles / substitutions
  { jp: 'プレイヤー', en: '[PLAYER_NAME]', source: 'engine', notes: 'Opcode 0x01F4 substitutes runtime name. Width budget: 10 chars.' },
  { jp: 'ガッコウ', en: '[SCHOOL_NAME]', source: 'engine', notes: 'Opcode 0x01F8 — school name from save data.' },

  // Magic system
  { jp: 'あいさつ', en: 'greeting', source: 'canon-G1' },
  { jp: 'まほう', en: 'magic', source: 'canon-G1' },
  { jp: 'まじない', en: 'incantation', source: 'canon-G1' },
  { jp: 'UMA', en: 'UMA', source: 'canon-G1', notes: 'Unidentified Mysterious Animal' },
  { jp: 'こいびと', en: 'sweetheart', source: 'canon-G1' },
];
---

<FieldGuideLayout
  title="Glossary — project canon"
  description="JP → EN canonical mappings the patch keeps consistent. Sourced from Game 1 Konami EN, Tyler confirmations, project decisions."
  crumbs={[
    { label: 'Field Guide', href: `${base}/field-guide/` },
    { label: 'Translation Canon', href: `${base}/field-guide/translation-canon/` },
    { label: 'Glossary' },
  ]}
>
  <h2>Source legend</h2>
  <table>
    <thead><tr><th>Tag</th><th>Meaning</th></tr></thead>
    <tbody>
      <tr><td><code>canon-G1</code></td><td>Konami EN canon from Game 1 (Magician's Quest, NDS).</td></tr>
      <tr><td><code>canon-G3</code></td><td>Tongari Boushi (Game 3) project decision; no Game-1 anchor.</td></tr>
      <tr><td><code>engine</code></td><td>Runtime substitution opcode, not literal text.</td></tr>
      <tr><td><code>fresh</code></td><td>No canon match; minimal EN crafted to fit width budget.</td></tr>
    </tbody>
  </table>

  <h2>Canon table (project-wide)</h2>
  <p>
    Cross-referenced canon includes the 244 confirmed NPC names
    (<a href={`${base}/field-guide/translation-canon/npc-names/`}>full NPC list</a>),
    377 magic glyphs
    (<a href={`${base}/field-guide/names-and-words/magic-glyphs/`}>full glyph table</a>),
    49 UCC food sub-records
    (<a href={`${base}/field-guide/names-and-words/food-recipes/`}>recipe table</a>),
    and 26 ARM9 menu strings
    (<a href={`${base}/field-guide/names-and-words/arm9-menu-pool/`}>ARM9 pool</a>).
    Highlights below.
  </p>

  <table>
    <thead><tr><th>JP</th><th>EN canon</th><th>source</th><th>notes</th></tr></thead>
    <tbody>
      {GLOSSARY.map(g => (
        <tr>
          <td><code>{g.jp}</code></td>
          <td><strong>{g.en}</strong></td>
          <td>{g.source}</td>
          <td>{g.notes || ''}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>Source</h2>
  <ul>
    <li><code>extracted/scratch/db/translation.sqlite</code> — all canon tables</li>
    <li>Game 1: <code>root/npc/NpcName_e.ofs</code>, <code>root/item/ItemName_e.ofs</code>, <code>picstat/magic/msg_e.dat</code></li>
    <li><code>notes/applied_project_canon_changes.md</code> — project-level decisions</li>
  </ul>
</FieldGuideLayout>
