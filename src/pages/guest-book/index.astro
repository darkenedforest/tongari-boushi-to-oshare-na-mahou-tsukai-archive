---
import Layout from '../../layouts/Layout.astro';
import GuestbookBoard from '../../components/GuestbookBoard.tsx';

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Guest Book"
  description="Sign the Tongari Boushi archive guest book — draw, type, and stamp your own pixel card with real assets from the game."
>
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>Guest Book</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/quill-pen.png`} alt="" />
      <img src={`${base}/decorations/crown.png`} alt="" />
      <img src={`${base}/decorations/butterfly-yellow.png`} alt="" />
    </div>
    <h1>Guest Book ✦</h1>
    <p class="lede">
      Leave your mark! Make a little card — draw on it pixel by pixel, type a
      note, stamp it with real sprites from the game, pick a background — and
      pin it to the wall for everyone to see.
    </p>
  </section>

  <section class="board-section">
    <GuestbookBoard client:load />
  </section>
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }

  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }

  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }

  .header-sprites {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 6px 0 4px;
    opacity: 0.78;
  }

  .header-sprites img {
    width: 40px;
    height: 40px;
  }

  .lede {
    max-width: 62ch;
    line-height: 1.6;
    color: var(--color-ink);
  }

  .board-section {
    margin: 10px 0 60px;
  }
</style>
