---
// Section moved: the per-overlay catalog used to live at /overlays/
// (top-level). It is now a research-knowledge section inside the
// Field Guide. The new home preserves the same per-overlay data with
// reframed descriptive copy.
const base = import.meta.env.BASE_URL;
const baseNorm = base.replace(/\/$/, '');
const target = `${baseNorm}/field-guide/how-the-game-works/overlays/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Overlays moved — Tongari Boushi Archive</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style>
      body {
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        max-width: 640px;
        margin: 60px auto;
        padding: 0 24px;
        color: #3a2350;
        line-height: 1.6;
      }
      a {
        color: #6f3fa3;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <h1>Overlays moved</h1>
    <p>
      The overlays catalog now lives in the Field Guide as research
      knowledge:
      <a href={target}>{target}</a>
    </p>
    <p>You will be redirected automatically.</p>
  </body>
</html>
