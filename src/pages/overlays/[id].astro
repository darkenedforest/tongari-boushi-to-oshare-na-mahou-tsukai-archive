---
// Per-overlay detail pages moved to
// /field-guide/how-the-game-works/overlays/<id>/.
// We still build redirect stubs for every previously-existing /overlays/<id>/
// URL so existing links keep working.
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

interface Overlay { id: number; }
interface Snapshot { overlays: Overlay[]; }

export async function getStaticPaths() {
  const here = path.dirname(fileURLToPath(import.meta.url));
  const snapPath = path.resolve(here, '..', '..', '..', 'public', 'data', 'overlays.json');
  const snapRaw = readFileSync(snapPath, 'utf-8');
  const snap: Snapshot = JSON.parse(snapRaw);
  return snap.overlays.map(o => ({
    params: { id: String(o.id) },
    props: { id: o.id },
  }));
}

interface Props { id: number; }
const { id } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseNorm = base.replace(/\/$/, '');
const target = `${baseNorm}/field-guide/how-the-game-works/overlays/${id}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{`ov${String(id).padStart(3, '0')} moved`}</title>
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style>
      body {
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        max-width: 640px;
        margin: 60px auto;
        padding: 0 24px;
        color: #3a2350;
        line-height: 1.6;
      }
      a {
        color: #6f3fa3;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <h1>{`ov${String(id).padStart(3, '0')} moved`}</h1>
    <p>
      This per-overlay page now lives in the Field Guide:
      <a href={target}>{target}</a>
    </p>
    <p>You will be redirected automatically.</p>
  </body>
</html>
