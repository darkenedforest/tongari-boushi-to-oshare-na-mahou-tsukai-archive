---
import Layout from '../../layouts/Layout.astro';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

interface ContainerRef {
  name: string;
  path: string | null;
  is_patched: boolean | null;
  note: string | null;
}

interface EmbeddedString {
  addr: string;
  value: string;
}

interface FunctionRow {
  index: number;
  addr: string;
  size: number;
  calls: number;
  strings: number;
  role_hint: string;
}

interface Overlay {
  id: number;
  file_id: number | null;
  ram_load_addr: string;
  ram_size: number | null;
  ram_size_hex: string | null;
  bss_size: number | null;
  size_compressed: number | null;
  compression_flag: string;
  function_count: number;
  string_count: number;
  unpatched_container_count: number;
  external_call_count: number | null;
  data_count: number | null;
  jump_table_count: number | null;
  prior_pass_role: string | null;
  prior_pass_category: string | null;
  containers_referenced: ContainerRef[];
  embedded_jp_strings: EmbeddedString[];
  function_list: FunctionRow[];
  purpose_summary: string;
  translation_surface_summary: string;
  open_questions: string[];
  conflicts: string[];
}

interface Snapshot {
  generated_at: string;
  total: number;
  overlays: Overlay[];
}

export async function getStaticPaths() {
  const here = path.dirname(fileURLToPath(import.meta.url));
  const snapPath = path.resolve(here, '..', '..', '..', 'public', 'data', 'overlays.json');
  const snapRaw = readFileSync(snapPath, 'utf-8');
  const snap: Snapshot = JSON.parse(snapRaw);
  // We need the full sorted-id list on the detail page to render prev/next
  // links, so pass it as a prop rather than re-reading the snapshot per-page.
  const sortedIds = snap.overlays.map(o => o.id).sort((a, b) => a - b);
  return snap.overlays.map(o => ({
    params: { id: String(o.id) },
    props: { overlay: o, sortedIds },
  }));
}

interface Props {
  overlay: Overlay;
  sortedIds: number[];
}

const { overlay, sortedIds } = Astro.props;
const base = import.meta.env.BASE_URL;
const baseNorm = base.replace(/\/$/, '');

function pad3(n: number): string {
  return n.toString().padStart(3, '0');
}
function fmt(n: number | null | undefined): string {
  return n == null ? '—' : n.toLocaleString();
}
function bytes(n: number | null | undefined): string {
  return n == null ? '—' : `${n.toLocaleString()} bytes`;
}

const ovLabel = `ov${pad3(overlay.id)}`;

// Prev / next links — ids are not guaranteed contiguous, so look them up.
const myIdx = sortedIds.indexOf(overlay.id);
const prevId = myIdx > 0 ? sortedIds[myIdx - 1] : null;
const nextId = myIdx >= 0 && myIdx < sortedIds.length - 1 ? sortedIds[myIdx + 1] : null;

const hasSurface = overlay.string_count > 0 || overlay.unpatched_container_count > 0;
const patchedContainers = overlay.containers_referenced.filter(c => c.is_patched === true);
const unpatchedContainers = overlay.containers_referenced.filter(c => c.is_patched === false);
const unknownContainers = overlay.containers_referenced.filter(c => c.is_patched == null);

const totalFnBytes = overlay.function_list.reduce((s, f) => s + f.size, 0);
const ramSize = overlay.ram_size ?? 0;
const coveragePct = ramSize > 0 ? Math.round((totalFnBytes / ramSize) * 100) : null;
---

<Layout title={`${ovLabel} — overlay`}>
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`${baseNorm}/overlays/`}>Overlays</a>
      <span aria-hidden="true">›</span>
      <span>{ovLabel}</span>
    </p>

    <h1>
      <span class="ov-id">{ovLabel}</span>
      {overlay.prior_pass_role && (
        <span class="role-pill">{overlay.prior_pass_role}</span>
      )}
    </h1>
    <p class="lede">
      {overlay.purpose_summary || '(no purpose summary)'}
    </p>

    <div class="prev-next">
      {prevId != null ? (
        <a href={`${baseNorm}/overlays/${prevId}/`}>‹ ov{pad3(prevId)}</a>
      ) : (
        <span class="dim">‹ start</span>
      )}
      <a href={`${baseNorm}/overlays/`} class="up">All overlays</a>
      {nextId != null ? (
        <a href={`${baseNorm}/overlays/${nextId}/`}>ov{pad3(nextId)} ›</a>
      ) : (
        <span class="dim">end ›</span>
      )}
    </div>
  </section>

  <section class="ov-section">
    <h2>Header</h2>
    <div class="header-grid">
      <div class="hg-cell">
        <span class="hg-key">Overlay ID</span>
        <span class="hg-val mono">{overlay.id}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">File ID</span>
        <span class="hg-val mono">{overlay.file_id ?? '—'}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">RAM load address</span>
        <span class="hg-val mono">{overlay.ram_load_addr || '—'}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">RAM size</span>
        <span class="hg-val">
          {bytes(overlay.ram_size)}
          {overlay.ram_size_hex && <span class="hg-aux mono"> ({overlay.ram_size_hex})</span>}
        </span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">BSS size</span>
        <span class="hg-val">{bytes(overlay.bss_size)}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">Compressed size</span>
        <span class="hg-val">{bytes(overlay.size_compressed)}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">Compression</span>
        <span class="hg-val mono">{overlay.compression_flag || '—'}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">Functions</span>
        <span class="hg-val">{fmt(overlay.function_count)}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">External calls</span>
        <span class="hg-val">{fmt(overlay.external_call_count)}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">Jump tables</span>
        <span class="hg-val">{fmt(overlay.jump_table_count)}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">Data items</span>
        <span class="hg-val">{fmt(overlay.data_count)}</span>
      </div>
      <div class="hg-cell">
        <span class="hg-key">Code coverage</span>
        <span class="hg-val">
          {coveragePct == null ? '—' : `${coveragePct}%`}
          <span class="hg-aux"> ({totalFnBytes.toLocaleString()} of {bytes(overlay.ram_size)})</span>
        </span>
      </div>
    </div>
  </section>

  <section class={hasSurface ? 'ov-section ov-section-surface' : 'ov-section'}>
    <h2>Translation surface</h2>
    <p class="surface-summary">{overlay.translation_surface_summary}</p>

    {overlay.embedded_jp_strings.length > 0 && (
      <>
        <h3>Embedded UTF-16 LE strings ({overlay.embedded_jp_strings.length})</h3>
        <p class="hint">
          These live inside the overlay binary itself — translating them
          requires patching the overlay bytes, not just swapping a container
          file.
        </p>
        <div class="strings-list">
          {overlay.embedded_jp_strings.map(s => (
            <div class="string-row">
              <span class="string-addr mono">{s.addr}</span>
              <span class="string-val">{s.value}</span>
            </div>
          ))}
        </div>
      </>
    )}

    {overlay.containers_referenced.length > 0 && (
      <>
        <h3>Container references ({overlay.containers_referenced.length})</h3>
        {unpatchedContainers.length > 0 && (
          <>
            <h4 class="csub csub-bad">
              Unpatched ({unpatchedContainers.length}) — still Japanese
            </h4>
            <ul class="container-list">
              {unpatchedContainers.map(c => (
                <li>
                  <span class="badge badge-bad">unpatched</span>
                  <code>{c.name}</code>
                  {c.path && <span class="container-path"> → <code>{c.path}</code></span>}
                </li>
              ))}
            </ul>
          </>
        )}
        {patchedContainers.length > 0 && (
          <>
            <h4 class="csub csub-ok">Patched ({patchedContainers.length})</h4>
            <ul class="container-list">
              {patchedContainers.map(c => (
                <li>
                  <span class="badge badge-ok">patched</span>
                  <code>{c.name}</code>
                  {c.path && <span class="container-path"> → <code>{c.path}</code></span>}
                </li>
              ))}
            </ul>
          </>
        )}
        {unknownContainers.length > 0 && (
          <>
            <h4 class="csub csub-dim">
              Other ({unknownContainers.length}) — no matching container in
              clean extract
            </h4>
            <p class="hint">
              These container basenames appeared in the overlay's string table
              but no file of that name was found in <code>ROM/.../data/</code>.
              Usually false-positive ASCII matches (function names, register
              maps) — kept here for completeness.
            </p>
            <ul class="container-list container-list-dim">
              {unknownContainers.map(c => (
                <li>
                  <span class="badge badge-dim">?</span>
                  <code>{c.name}</code>
                  {c.note && <span class="container-note"> — {c.note}</span>}
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )}

    {!hasSurface && overlay.containers_referenced.length === 0 && (
      <p class="hint">This overlay has no translation surface — pure code.</p>
    )}
  </section>

  <section class="ov-section">
    <h2>Function list</h2>
    <p class="hint">
      Functions Ghidra auto-identified. Names prefixed <code>FUN_</code> are
      auto-generated; size is in bytes; "calls" counts both intra-overlay and
      ARM9 external calls.
    </p>
    <details class="fn-details">
      <summary>
        Show all {overlay.function_count} function{overlay.function_count === 1 ? '' : 's'}
      </summary>
      <div class="fn-table-wrap">
        <table class="fn-table">
          <thead>
            <tr>
              <th class="num">#</th>
              <th>Address</th>
              <th class="num">Size</th>
              <th class="num">Calls</th>
              <th class="num">Strings</th>
              <th>Role hint</th>
            </tr>
          </thead>
          <tbody>
            {overlay.function_list.map(f => (
              <tr>
                <td class="num">{f.index}</td>
                <td class="mono">{f.addr}</td>
                <td class="num">{f.size.toLocaleString()}</td>
                <td class="num">{f.calls}</td>
                <td class="num">{f.strings}</td>
                <td class="role">{f.role_hint}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  {(overlay.open_questions.length > 0 || overlay.conflicts.length > 0) && (
    <section class="ov-section">
      <h2>Open questions &amp; conflicts</h2>
      {overlay.open_questions.length > 0 && (
        <>
          <h3>Open questions / unknowns</h3>
          <ul class="oq-list">
            {overlay.open_questions.map(q => <li>{q}</li>)}
          </ul>
        </>
      )}
      {overlay.conflicts.length > 0 && (
        <>
          <h3>Conflicts with prior shallow pass</h3>
          <ul class="oq-list">
            {overlay.conflicts.map(c => <li>{c}</li>)}
          </ul>
        </>
      )}
    </section>
  )}

  <section class="ov-section">
    <h2>Source</h2>
    <p class="hint">
      Generated from Ghidra 11.3.1 headless reverse-engineering pass. Per-overlay
      markdown:
      <code>notes/overlay_knowledgebase/ov{pad3(overlay.id)}.md</code>;
      raw Ghidra dump:
      <code>notes/overlay_knowledgebase/raw/ov{pad3(overlay.id)}.json</code>.
    </p>
  </section>

  <div class="prev-next prev-next-bottom">
    {prevId != null ? (
      <a href={`${baseNorm}/overlays/${prevId}/`}>‹ ov{pad3(prevId)}</a>
    ) : (
      <span class="dim">‹ start</span>
    )}
    <a href={`${baseNorm}/overlays/`} class="up">All overlays</a>
    {nextId != null ? (
      <a href={`${baseNorm}/overlays/${nextId}/`}>ov{pad3(nextId)} ›</a>
    ) : (
      <span class="dim">end ›</span>
    )}
  </div>
</Layout>

<style>
  .page-header { padding: 36px 0 12px; }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }
  h1 {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 6px 0 8px;
  }
  .ov-id {
    font-family: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;
    color: var(--color-pink-600);
  }
  .role-pill {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--color-pink-100), var(--color-purple-100));
    color: var(--color-purple-600);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .lede {
    max-width: 70ch;
    line-height: 1.6;
    color: var(--color-ink);
    font-size: 1.02rem;
  }

  .prev-next {
    display: flex;
    gap: 16px;
    align-items: center;
    margin: 12px 0 6px;
    font-weight: 600;
  }
  .prev-next a {
    color: var(--color-purple-600);
    text-decoration: none;
    border-bottom: 1px dashed rgba(111, 63, 163, 0.35);
  }
  .prev-next a:hover { color: var(--color-pink-600); }
  .prev-next .up {
    margin-left: auto;
    margin-right: auto;
    color: var(--color-ink-soft);
  }
  .prev-next .dim { color: var(--color-ink-soft); opacity: 0.5; }
  .prev-next-bottom { margin: 30px 0 60px; }

  .ov-section {
    margin: 28px 0;
    padding: 18px 20px;
    background: var(--surface-strong);
    border: 1px solid var(--color-pink-100);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }
  .ov-section h2 {
    margin: 0 0 12px;
    color: var(--color-purple-600);
    font-size: 1.2rem;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-pink-100);
  }
  .ov-section h3 {
    margin: 20px 0 8px;
    color: var(--color-pink-600);
    font-size: 1rem;
  }
  .ov-section h4 {
    margin: 14px 0 6px;
    font-size: 0.92rem;
  }
  .ov-section p { line-height: 1.6; color: var(--color-ink); margin: 0 0 10px; }
  .ov-section-surface {
    border-color: var(--color-pink-200, #ffb1c8);
    background: linear-gradient(180deg, rgba(255, 240, 246, 0.5), white 30%);
  }
  .surface-summary {
    font-size: 1rem;
    color: var(--color-purple-600);
    font-weight: 600;
  }
  .hint {
    color: var(--color-ink-soft);
    font-size: 0.9rem;
  }
  .mono { font-family: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace; }

  .header-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px 14px;
  }
  .hg-cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    background: rgba(255, 240, 246, 0.4);
    border-radius: 8px;
  }
  .hg-key {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-purple-600);
    font-weight: 700;
  }
  .hg-val { font-size: 0.95rem; color: var(--color-ink); }
  .hg-aux { color: var(--color-ink-soft); font-size: 0.85rem; }

  .csub-bad { color: #a31049; }
  .csub-ok { color: #1d6c2b; }
  .csub-dim { color: var(--color-ink-soft); }

  .strings-list {
    display: grid;
    gap: 4px;
  }
  .string-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 12px;
    padding: 6px 10px;
    background: rgba(232, 220, 255, 0.32);
    border-radius: 6px;
    align-items: baseline;
  }
  .string-addr { color: var(--color-purple-600); font-size: 0.85rem; }
  .string-val {
    font-family: 'Noto Sans JP', sans-serif;
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  .container-list {
    list-style: none;
    margin: 6px 0 12px;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .container-list li {
    padding: 6px 10px;
    background: rgba(255, 240, 246, 0.38);
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .container-list-dim li { background: rgba(0,0,0,0.02); }
  .container-list code {
    font-family: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;
    background: white;
    padding: 1px 6px;
    border-radius: 4px;
    color: var(--color-ink);
    font-size: 0.88rem;
  }
  .container-path code { color: var(--color-purple-600); }
  .container-note { color: var(--color-ink-soft); font-size: 0.85rem; }

  .badge {
    display: inline-block;
    padding: 1px 8px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .badge-bad { background: #ffd8e2; color: #a31049; }
  .badge-ok { background: #d1f5d8; color: #1d6c2b; }
  .badge-dim { background: rgba(0,0,0,0.06); color: var(--color-ink-soft); }

  .fn-details summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--color-purple-600);
    padding: 6px 0;
  }
  .fn-table-wrap {
    margin-top: 10px;
    overflow-x: auto;
    background: white;
    border-radius: 8px;
    border: 1px solid var(--color-pink-100);
  }
  .fn-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .fn-table thead {
    background: linear-gradient(135deg, var(--color-pink-100), var(--color-purple-100));
  }
  .fn-table th, .fn-table td {
    padding: 6px 10px;
    text-align: left;
    border-bottom: 1px solid var(--color-pink-100);
  }
  .fn-table th.num, .fn-table td.num { text-align: right; }
  .fn-table .mono {
    font-family: 'JetBrains Mono', 'Cascadia Code', Consolas, monospace;
    color: var(--color-purple-600);
  }
  .fn-table .role { color: var(--color-ink-soft); font-size: 0.85rem; }

  .oq-list { margin: 0; padding-left: 22px; }
  .oq-list li {
    color: var(--color-ink);
    line-height: 1.55;
    margin-bottom: 4px;
  }
</style>
