---
import Layout from '../../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const patchUrl = `${base}/patches/tongari-boushi-en-v2.32-rev1-test.xdelta`;
const patchSize = '3.10 MB';
const patchedRomSha256 = 'bd0a1e87ee75b5c00c11e0a245ed346cdb72d186a4f17523ea05005b72f2e5af';
---

<Layout title="v2.32 Rev 1 test build">
  <!-- NOTE: this page is unlinked from the rest of the site.
       Header.astro nav does not include /test/. Patches page does not
       reference v2.32-rev1-test. It is reachable only by direct URL. -->
  <section class="page-header">
    <h1>Tongari Boushi v2.32 — Rev 1 test build</h1>
    <p class="lede">
      Test build for Freedom. Not the public release.
    </p>
  </section>

  <section class="card download-card">
    <h2>Download</h2>
    <a class="big-button" href={patchUrl} download>
      tongari-boushi-en-v2.32-rev1-test.xdelta&nbsp;
      <span class="size">({patchSize})</span>
    </a>
    <dl class="meta">
      <dt>Source ROM</dt>
      <dd>JP <strong>Rev 1</strong> (filename usually ends with <code>(J) Rev 1.nds</code>)</dd>
    </dl>
  </section>

  <section class="card">
    <h2>What you'll see different from v2.31</h2>
    <ul class="changes">
      <li>
        When you catch something at the fishing spot, the dialog now
        goes straight to the next screen instead of making you tap
        through 16 blank pages first. Affects every catch result —
        fish, shellfish, the random Door Key, all of it.
      </li>
      <li>
        NPC conversations don't throw in an extra empty dialog page
        mid-line anymore. If you ever felt like you were pressing A on
        a blank box between lines, that's the thing that's gone.
      </li>
      <li>
        Bug-book and fish-book donation menus no longer kick you back
        to a blank prompt screen between every choice. Donating an
        insect to the bug guy or handing a fish to the fish king now
        flows straight through.
      </li>
      <li>
        Prices in dialog like "It costs 1170 Ritch" display correctly
        instead of doubling up (the old "11701170!" bug).
      </li>
      <li>
        The item called "Jewelry Case" is now "Jewelry Box" — in your
        inventory, in shop catalogs, in recipe results, and anywhere
        an NPC references it in dialog.
      </li>
      <li>
        The item called "Relaxing Tea" is now "Calming Tea" — same
        scope: inventory, shops, recipe results, NPC dialog
        references.
      </li>
    </ul>
  </section>

  <section class="card">
    <h2>How to apply</h2>
    <ol>
      <li>
        Get the JP <strong>Rev 1</strong> ROM of <em>Tongari Boushi to
        Oshare na Mahou Tsukai</em>. The filename usually ends in
        <code>(J) Rev 1.nds</code>. Confirm with an MD5 / SHA256 of the
        clean dump if you have one to compare against.
      </li>
      <li>
        Use <a href="https://www.romhacking.net/utilities/704/" target="_blank" rel="noopener">Delta Patcher</a>
        (or any xdelta3-compatible tool):
        <ul class="bare">
          <li>Original file → your JP Rev 1 ROM</li>
          <li>XDelta patch → the <code>.xdelta</code> downloaded above</li>
          <li>Apply</li>
        </ul>
      </li>
      <li>
        The output should be a 268,435,456-byte <code>.nds</code> file.
      </li>
    </ol>
    <p class="muted small">
      Equivalent command-line: <code>xdelta3 -d -s &lt;jp-rev1.nds&gt; tongari-boushi-en-v2.32-rev1-test.xdelta &lt;out.nds&gt;</code>
    </p>
  </section>

  <section class="card">
    <h2>Build identifier</h2>
    <p class="meta-hash">
      Patched ROM SHA-256: <code>{patchedRomSha256}</code>
    </p>
  </section>
</Layout>

<style>
  .page-header {
    padding: 40px 0 12px;
  }

  .page-header h1 {
    margin: 0 0 14px;
    font-size: 1.9rem;
  }

  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
    font-size: 1.05rem;
  }

  .card {
    background: var(--surface-strong);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-pink-100);
    box-shadow: var(--shadow-soft);
    padding: 24px 28px;
    margin: 22px 0;
  }

  .card h2 {
    margin: 0 0 14px;
    font-size: 1.2rem;
    color: var(--color-purple-600);
  }

  .download-card {
    text-align: left;
  }

  .big-button {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 14px 22px;
    background: linear-gradient(135deg, var(--color-pink-400), var(--color-purple-400));
    color: white;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    box-shadow: 0 6px 16px rgba(155, 123, 217, 0.25);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .big-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(155, 123, 217, 0.35);
    color: white;
  }

  .big-button .size {
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.85;
  }

  .meta {
    margin: 18px 0 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
    font-size: 0.92rem;
  }

  .meta dt {
    color: var(--color-ink-soft);
    font-weight: 600;
  }

  .meta dd {
    margin: 0;
  }

  .meta code {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.82rem;
    color: var(--color-purple-600);
    background: var(--color-purple-50);
    padding: 2px 8px;
    border-radius: 6px;
    word-break: break-all;
    border: 1px solid var(--color-purple-100);
  }

  .intro {
    margin: 0 0 14px;
    line-height: 1.55;
    color: var(--color-ink);
  }

  .changes {
    margin: 0;
    padding-left: 22px;
    line-height: 1.65;
  }

  .changes li {
    margin: 12px 0;
  }

  .changes li::marker {
    color: var(--color-pink-400);
  }

  .changes strong {
    color: var(--color-purple-600);
  }

  .not-in {
    margin: 18px 0 0;
    padding: 12px 14px;
    background: var(--color-purple-50);
    border-left: 3px solid var(--color-purple-400);
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    color: var(--color-ink);
  }

  .gates {
    margin: 0;
    padding-left: 22px;
    line-height: 1.6;
  }

  .gates li {
    margin: 6px 0;
  }

  .gates strong {
    color: var(--color-pink-600);
  }

  .meta-hash {
    margin: 14px 0 0;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .meta-hash code {
    word-break: break-all;
  }

  ol {
    padding-left: 22px;
    line-height: 1.6;
  }

  ol li {
    margin: 8px 0;
  }

  .bare {
    list-style: disc;
    padding-left: 20px;
    margin: 6px 0;
  }

  .bare li {
    margin: 2px 0;
  }

  .muted {
    color: var(--color-ink-soft);
  }

  .small {
    font-size: 0.88rem;
  }

  code {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.88em;
    background: var(--color-purple-50);
    padding: 1px 6px;
    border-radius: 6px;
    color: var(--color-purple-600);
  }
</style>
