---
import Layout from '../../layouts/Layout.astro';
import TranslationViewer from '../../components/TranslationViewer.tsx';

// The EN-only lookup is shipped as a public asset. The main translation
// repo's `_export_en_lookup_for_rom_viewer.py` writes it.
const base = import.meta.env.BASE_URL;
const baseNorm = base.replace(/\/$/, '');
const lookupUrl = `${baseNorm}/data/translation_en_lookup.json`;
const decorationBase = `${baseNorm}/decorations/`;
---

<Layout title="Translation Viewer">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`${base}/translation/`}>Translation</a>
      <span aria-hidden="true">›</span>
      <span>Viewer</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/butterfly-yellow.png`} alt="" />
      <img src={`${base}/decorations/magic-lamp-crystal.png`} alt="" />
      <img src={`${base}/decorations/dragonfly.png`} alt="" />
    </div>
    <h1>Translation Viewer ✦</h1>
    <p class="lede">
      Browse the in-progress fan translation side-by-side with the original
      Japanese. The English text comes from the patch database hosted here.
      The Japanese text is extracted, in your browser, from
      <em>your own copy</em> of the Tongari Boushi NDS ROM — nothing about the
      ROM uploads to the server. Pick a file on the left, then a Textblock,
      to read the pair along with each phrase row.
    </p>
    <p class="meta">
      <span>Scope: <strong>letters &amp; bulletins</strong> (msg98 family)</span>
      <span class="dot">·</span>
      <span><strong>76</strong> files</span>
      <span class="dot">·</span>
      <span><strong>1,077</strong> Textblocks</span>
    </p>
    <details class="tips">
      <summary>How this works</summary>
      <ul>
        <li>
          Click <strong>Load ROM…</strong> and pick your <code>.nds</code> file. The page
          parses the ROM locally — there's no upload, and no copy is kept after
          you close the tab.
        </li>
        <li>
          Tags like <code>[PLAYER_NAME]</code>, <code>[NPC:1009]</code>, and
          <code>[LETTER_ADDRESSEE]</code> are runtime substitution slots. The
          grey <code>&lt;i&gt;HEX&lt;/i&gt;</code> chips are raw control-code bytes the
          game runs.
        </li>
        <li>
          The English side ships pre-loaded. You can still search and read
          translations even without a ROM — but the Japanese panels stay
          locked until you load one.
        </li>
      </ul>
    </details>
  </section>

  <TranslationViewer lookupUrl={lookupUrl} decorationBase={decorationBase} client:only="react" />
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }
  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }
  .header-sprites {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 6px 0 4px;
    opacity: 0.78;
  }
  .header-sprites img {
    width: 40px;
    height: 40px;
  }
  .header-sprites img:nth-child(2) {
    width: 48px;
    height: 48px;
  }
  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.88rem;
    margin: 6px 0 18px;
  }
  .meta strong { color: var(--color-purple-600); }
  .meta .dot { opacity: 0.5; }
  .tips {
    background: var(--color-purple-50);
    border: 1px solid var(--color-purple-100);
    border-radius: var(--radius-md);
    padding: 10px 16px;
    margin: 0 0 8px;
    max-width: 720px;
  }
  .tips summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-purple-600);
    font-size: 0.92rem;
  }
  .tips ul {
    margin: 8px 0 4px;
    padding-left: 20px;
    color: var(--color-ink);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .tips code {
    background: white;
    padding: 1px 6px;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
  }
</style>
