---
import Layout from '../../layouts/Layout.astro';
import BugReportsBoard from '../../components/BugReportsBoard.tsx';

const base = import.meta.env.BASE_URL;
---

<Layout title="Bug Reports">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>Bug Reports</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/butterfly-yellow.png`} alt="" />
      <img src={`${base}/decorations/magic-lamp-crystal.png`} alt="" />
      <img src={`${base}/decorations/dragonfly.png`} alt="" />
    </div>
    <h1>Bug Reports ✦</h1>
    <p class="lede">
      Hit something broken in the patch or the site? Got an idea? Drop a
      report — no account, no login, just type and post. Attach screenshots
      if you have them. If two or more people run into the same thing, hit
      "Me too" so it floats to the top. If you've found a fix or a workaround,
      drop a comment on the report.
    </p>
  </section>

  <BugReportsBoard client:load />
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }
  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }
  .header-sprites {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 6px 0 4px;
    opacity: 0.78;
  }
  .header-sprites img {
    width: 40px;
    height: 40px;
  }
  .header-sprites img:nth-child(2) {
    width: 48px;
    height: 48px;
  }
  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
  }
</style>
