---
import Layout from '../../layouts/Layout.astro';
import SaveFileInspector from '../../components/SaveFileInspector.tsx';

const base = import.meta.env.BASE_URL;
---

<Layout title="Save-file editor">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>Save Files</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/key.png`} alt="" />
      <img src={`${base}/decorations/magic-lamp-tall.png`} alt="" />
      <img src={`${base}/decorations/quill-pen.png`} alt="" />
    </div>
    <h1>Save-file editor ✦</h1>
    <p class="lede">
      Drop in a Tongari Boushi save file — emulator, flashcart, original
      cartridge dump — and the page decodes the regions we currently know
      how to parse, plus exposes the fields that are safe to edit.
    </p>
    <p class="jp-note">
      <strong>JP-version saves work too</strong> — any ROM revision, any
      region. Patched-ROM and unpatched JP saves both parse.
    </p>
    <p class="features">
      <strong>What you can edit:</strong> Ritch (currency), player name,
      school name, mail announcements (edit text or remove the entry), and
      the 15-slot inventory bag. Active-slot detection routes edits to the
      most recently written save slot, with mirrors kept in sync. Header
      and body checksums are recomputed on download so the modified save
      loads cleanly in-game.
    </p>
    <p class="how-to">
      <strong>How to use it:</strong> drop your .sav (or .dsv / .duc /
      .savn / .dat / .bin) below. The editor lays out every parsed region
      in a scrollable view. Make your edits inline; hit
      <em>Save &amp; download</em> at the bottom to grab a modified copy.
      The original file stays untouched. Back up your save before you
      start, especially when editing anything beyond Ritch or your player
      name.
    </p>
  </section>

  <SaveFileInspector client:load />
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }
  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }
  .header-sprites {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 6px 0 4px;
    opacity: 0.78;
  }
  .header-sprites img {
    width: 40px;
    height: 40px;
  }
  .header-sprites img:nth-child(2) {
    width: 48px;
    height: 48px;
  }
  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .jp-note {
    max-width: 64ch;
    line-height: 1.55;
    color: var(--color-ink);
    background: var(--color-purple-50);
    border: 1px solid var(--color-purple-100);
    border-left: 4px solid var(--color-purple-400);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-size: 0.92rem;
    margin: 8px 0;
  }
  .jp-note strong {
    color: var(--color-purple-600);
  }
  .features {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
    background: linear-gradient(135deg, var(--color-pink-50), var(--color-purple-50));
    border: 1px solid var(--color-pink-100);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    font-size: 0.92rem;
  }
  .features strong {
    color: var(--color-pink-600);
  }
  .how-to {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
    font-size: 0.95rem;
  }
  .how-to strong {
    color: var(--color-purple-600);
  }
  .how-to em {
    color: var(--color-pink-600);
    font-style: italic;
  }
</style>
