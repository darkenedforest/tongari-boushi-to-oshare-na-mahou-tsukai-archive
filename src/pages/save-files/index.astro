---
import Layout from '../../layouts/Layout.astro';
import SaveFileInspector from '../../components/SaveFileInspector.tsx';

const base = import.meta.env.BASE_URL;
---

<Layout title="Save-file editor">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>Save Files</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/key.png`} alt="" />
      <img src={`${base}/decorations/magic-lamp-tall.png`} alt="" />
      <img src={`${base}/decorations/quill-pen.png`} alt="" />
    </div>
    <h1>Save-file editor ✦</h1>
    <p class="lede">
      Drop in a Tongari Boushi save file — emulator, flashcart, original
      cartridge dump — and the page decodes the regions we currently know
      how to parse, plus exposes the fields that are safe to edit.
    </p>
    <p class="jp-note">
      <strong>JP-version saves work too</strong> — any ROM revision, any
      region. Patched-ROM and unpatched JP saves both parse.
    </p>
    <p class="board-note">
      <strong>New with patch v2.6.3 — repair and update your bulletin
      board.</strong> Older patches wrote board posts into a field too
      small for English, which garbled authors and dates and left some
      posts blank; v2.6.3 stores posts differently and retranslated all
      233 of them. The <em>Bulletin board</em> section below shows every
      post on your board, flags the corrupt ones for removal, and updates
      every post to the current translation (NPC names, item names and
      wording) in one click. Apply v2.6.3 first: the updated posts are
      written by the new game code the next time you open the board.
    </p>
    <p class="features">
      <strong>What you can edit:</strong> Ritch in the wallet and in the
      bank, wizard level and rank, player, shop and town names, the
      bulletin board (update posts to the current translation, remove
      corrupt posts, or rewrite a post), letter-queue text, the 15-slot
      inventory bag, and each NPC&apos;s affinity value. You can also see the
      four player-character records, your shop&apos;s shelves and sales ledger,
      custom-named items, and the world object grid. Active-slot detection
      routes edits to the most recently written save slot, with mirrors
      kept in sync. Every checksum the game verifies — header, body and the
      player record&apos;s own — is recomputed on download so the modified
      save loads cleanly in-game.
    </p>
    <p class="how-to">
      <strong>How to use it:</strong> drop your .sav (or .dsv / .duc /
      .savn / .dat / .bin) below. The editor lays out every parsed region
      in a scrollable view. Make your edits inline; hit
      <em>Save &amp; download</em> at the bottom to grab a modified copy.
      The original file stays untouched. Back up your save before you
      start, especially when editing anything beyond Ritch or your player
      name.
    </p>
  </section>

  <SaveFileInspector client:load />
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }
  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }
  .header-sprites {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 6px 0 4px;
    opacity: 0.78;
  }
  .header-sprites img {
    width: 40px;
    height: 40px;
  }
  .header-sprites img:nth-child(2) {
    width: 48px;
    height: 48px;
  }
  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .jp-note {
    max-width: 64ch;
    line-height: 1.55;
    color: var(--color-ink);
    background: var(--color-purple-50);
    border: 1px solid var(--color-purple-100);
    border-left: 4px solid var(--color-purple-400);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-size: 0.92rem;
    margin: 8px 0;
  }
  .jp-note strong {
    color: var(--color-purple-600);
  }
  .board-note {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
    background: linear-gradient(135deg, #fff7d6, var(--color-pink-50));
    border: 2px solid #f3d774;
    border-left: 6px solid #d99e1f;
    border-radius: var(--radius-md);
    padding: 12px 16px;
    font-size: 0.92rem;
    margin: 8px 0 12px;
  }
  .board-note strong {
    color: #8a5a00;
  }
  .board-note em {
    color: var(--color-pink-600);
    font-style: italic;
  }
  .features {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
    background: linear-gradient(135deg, var(--color-pink-50), var(--color-purple-50));
    border: 1px solid var(--color-pink-100);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    font-size: 0.92rem;
  }
  .features strong {
    color: var(--color-pink-600);
  }
  .how-to {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
    font-size: 0.95rem;
  }
  .how-to strong {
    color: var(--color-purple-600);
  }
  .how-to em {
    color: var(--color-pink-600);
    font-style: italic;
  }
</style>
