---
import Layout from '../../../layouts/Layout.astro';
import LazyImageGrid from '../../../components/LazyImageGrid.tsx';

const base = import.meta.env.BASE_URL;
const manifestUrl = `${base.replace(/\/$/, '')}/data/scenes_npc.json`;
---

<Layout title="NPC Scenes">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`${base}/scenes/`}>Scenes</a>
      <span aria-hidden="true">›</span>
      <span>NPC Scenes</span>
    </p>
    <h1>NPC Scenes ✦</h1>
    <p class="lede">
      Every speaker in the game has one of these — a single composite shot
      built from the NPC's face portrait, signature outfit card, the four
      expression sprites used during dialog, and a sample line in their
      voice. 252 cards total, indexed by <code>speaker_id</code>. Search by
      English or Japanese name.
    </p>
  </section>

  <LazyImageGrid
    client:load
    manifestUrl={manifestUrl}
    imagePrefix={`${base.replace(/\/$/, '')}/scenes/npc-scenes`}
    fileField="file"
    labelFields={['en', 'jp']}
    searchFields={['en', 'jp', 'speaker_id']}
    subField="speaker_id"
    pageSize={60}
  />
</Layout>

<style>
  .page-header { padding: 40px 0 12px; }
  .breadcrumb {
    display: flex; gap: 8px; align-items: center;
    color: var(--color-ink-soft); font-size: 0.9rem; margin: 0 0 12px;
  }
  .breadcrumb a { color: var(--color-purple-400); font-weight: 600; }
  .lede { max-width: 64ch; line-height: 1.6; color: var(--color-ink); }
  .lede code {
    background: var(--color-purple-50);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.88em;
    font-family: ui-monospace, monospace;
  }
</style>
