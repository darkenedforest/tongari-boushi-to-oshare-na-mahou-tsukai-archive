---
import Layout from '../../../layouts/Layout.astro';
import species from '../../../data/scenes_pet_aging.json';

const base = import.meta.env.BASE_URL;
---

<Layout title="Pet Aging">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`${base}/scenes/`}>Scenes</a>
      <span aria-hidden="true">›</span>
      <span>Pet Aging</span>
    </p>
    <h1>Pet Aging ✦</h1>
    <p class="lede">
      How each of the 66 pet species changes across the five life stages —
      Baby (levels 0–9), Adolescent (10–19), Adult (20–29), Senior (30–39),
      and Master (40–49). Each row shows the face textures and the body
      part that swaps in at that stage, with the XP threshold pulled from
      <code>PcPromotion.bin</code>. Click into any species to see the full
      progression chart.
    </p>
  </section>

  <section class="grid">
    {species.map((s: any) => (
      <figure class="card">
        <div class="img-wrap">
          <img src={`${base}/scenes/pet-aging/${s.file}`} alt={`Species ${s.species_idx}`} loading="lazy" />
        </div>
        <figcaption>
          <strong>Species #{String(s.species_idx).padStart(2, '0')}</strong>
        </figcaption>
      </figure>
    ))}
  </section>
</Layout>

<style>
  .page-header { padding: 40px 0 12px; }
  .breadcrumb {
    display: flex; gap: 8px; align-items: center;
    color: var(--color-ink-soft); font-size: 0.9rem; margin: 0 0 12px;
  }
  .breadcrumb a { color: var(--color-purple-400); font-weight: 600; }
  .lede { max-width: 64ch; line-height: 1.6; color: var(--color-ink); }
  .lede code {
    background: var(--color-purple-50);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 0.88em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 18px;
    padding: 16px 0 60px;
  }

  .card {
    margin: 0;
    background: var(--surface-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-pink-100);
    overflow: hidden;
  }

  .img-wrap {
    background: #1a1330;
    display: flex; justify-content: center;
  }

  .img-wrap img {
    width: 100%;
    height: auto;
    image-rendering: -webkit-optimize-contrast;
  }

  figcaption {
    padding: 10px 14px 12px;
    text-align: center;
  }

  figcaption strong {
    color: var(--color-purple-600);
    font-size: 0.95rem;
  }
</style>
