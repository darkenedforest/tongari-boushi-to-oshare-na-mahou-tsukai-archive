---
import Layout from '../../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const shots = [
  {
    file: 'hair-catalog.png',
    caption: 'Hair Catalog',
    desc: 'Every hairstyle the character creator offers, laid out grid-style with the in-game color palette applied to each.',
  },
  {
    file: 'magazines.png',
    caption: 'Magazines',
    desc: 'The big editorial titles that appear on magazine pages — pulled out of the magazine assets and tiled into one spread.',
  },
];
---

<Layout title="Family Showcase">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`${base}/scenes/`}>Scenes</a>
      <span aria-hidden="true">›</span>
      <span>Family Showcase</span>
    </p>
    <h1>Family Showcase ✦</h1>
    <p class="lede">
      Two big composite renders pulled from the family-showcases batch. The
      hair catalog is the full hairstyle pool the character creator pulls
      from. The magazines shot is the headline / banner art that floats over
      magazine pages in the in-game shop.
    </p>
  </section>

  <section class="shots">
    {shots.map(s => (
      <figure class="shot-card">
        <div class="shot-wrap">
          <img src={`${base}/scenes/family-showcase/${s.file}`} alt={s.caption} loading="lazy" />
        </div>
        <figcaption>
          <strong>{s.caption}</strong>
          <p>{s.desc}</p>
        </figcaption>
      </figure>
    ))}
  </section>
</Layout>

<style>
  .page-header { padding: 40px 0 12px; }
  .breadcrumb {
    display: flex; gap: 8px; align-items: center;
    color: var(--color-ink-soft); font-size: 0.9rem; margin: 0 0 12px;
  }
  .breadcrumb a { color: var(--color-purple-400); font-weight: 600; }
  .lede { max-width: 64ch; line-height: 1.6; color: var(--color-ink); }

  .shots {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 22px;
    padding: 16px 0 60px;
  }

  .shot-card {
    margin: 0;
    background: var(--surface-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-pink-100);
    overflow: hidden;
  }

  .shot-wrap {
    width: 100%;
    background: #1a1330;
    display: flex; justify-content: center;
    padding: 12px;
  }

  .shot-wrap img {
    max-width: 100%;
    height: auto;
    image-rendering: -webkit-optimize-contrast;
  }

  figcaption {
    padding: 14px 18px 18px;
  }

  figcaption strong {
    color: var(--color-purple-600);
    font-size: 1.05rem;
  }

  figcaption p {
    margin: 6px 0 0;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
  }
</style>
