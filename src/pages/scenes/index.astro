---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const categories = [
  {
    slug: 'npc-scenes',
    title: 'NPC Scenes',
    blurb: 'Every speaker in the game — face portrait, signature outfit card, the four expression sprites, and a sample line. 252 NPCs.',
    cover: 'speaker-1000.png',
    count: 252,
  },
  {
    slug: 'nsbva-previews',
    title: 'NSBVA Previews',
    blurb: 'Visibility-bone animations for in-world objects: lamps flicker, drawers open, fans spin. Strip + animated APNG per entry.',
    cover: 'room--0900-1--strip.png',
    count: 350,
  },
  {
    slug: 'pet-aging',
    title: 'Pet Aging',
    blurb: 'How each of the 66 pet species changes across Baby → Adolescent → Adult → Senior → Master life stages, with XP thresholds from PcPromotion.bin.',
    cover: 'species-00-progression.png',
    count: 66,
  },
  {
    slug: 'family-showcase',
    title: 'Family Showcase',
    blurb: 'Two big composite shots — the full hair catalog laid out grid-style, and the in-game magazine spreads.',
    cover: 'hair-catalog.png',
    count: 2,
  },
  {
    slug: 'cooking-progressions',
    title: 'Cooking Progressions',
    blurb: 'Each recipe shown as input item → glyph operation → output item, with the underlying state bytes from the recipe table.',
    cover: 'recipe-00.png',
    count: 55,
  },
  {
    slug: 'composed-outfits',
    title: 'Composed Outfits',
    blurb: 'Sample player outfits assembled from the clothing pool — top + bottom + hat + shoes layered into a single coord card.',
    cover: 'kimono-outfit.png',
    count: 15,
  },
];
---

<Layout title="Scenes">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>Scenes</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/butterfly-yellow.png`} alt="" />
      <img src={`${base}/decorations/parfait.png`} alt="" />
      <img src={`${base}/decorations/magic-lamp-crystal.png`} alt="" />
      <img src={`${base}/decorations/peach.png`} alt="" />
      <img src={`${base}/decorations/dragonfly.png`} alt="" />
    </div>
    <h1>Scenes ✦</h1>
    <p class="lede">
      Composed reference shots pulled together from the raw ROM data —
      character roster, pet life stages, recipe flows, animated furniture,
      outfit composites, big catalog spreads. Each one is built by a script
      that reads the underlying tables and renders them into something a
      human can actually look at.
    </p>
  </section>

  <section class="grid">
    {categories.map(cat => (
      <a href={`${base}/scenes/${cat.slug}/`} class="cat-card">
        <div class="thumb-wrap">
          <img
            src={`${base}/scenes/${cat.slug}/${cat.cover}`}
            alt=""
            loading="lazy"
          />
        </div>
        <div class="cat-body">
          <h3>{cat.title}</h3>
          <p class="cat-blurb">{cat.blurb}</p>
          <p class="cat-meta">
            <span class="count-badge">{cat.count.toLocaleString()} {cat.count === 1 ? 'render' : 'renders'}</span>
            <span class="cat-cta">Open →</span>
          </p>
        </div>
      </a>
    ))}
  </section>
</Layout>

<style>
  .page-header { padding: 40px 0 20px; }
  .breadcrumb {
    display: flex; gap: 8px; align-items: center;
    color: var(--color-ink-soft); font-size: 0.9rem; margin: 0 0 12px;
  }
  .breadcrumb a { color: var(--color-purple-400); font-weight: 600; }
  .header-sprites {
    display: flex; align-items: center; gap: 18px;
    margin: 6px 0 4px; opacity: 0.78;
  }
  .header-sprites img { width: 40px; height: 40px; }
  .header-sprites img:nth-child(3) { width: 48px; height: 48px; }
  .lede { max-width: 64ch; line-height: 1.6; color: var(--color-ink); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
    padding: 16px 0 60px;
  }

  .cat-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-pink-100);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pop);
    border-color: var(--color-pink-200);
  }

  .thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--color-purple-50), var(--color-pink-50));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .thumb-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
  }

  .cat-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .cat-body h3 { margin: 0; color: var(--color-purple-600); }

  .cat-blurb {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.92rem;
    line-height: 1.5;
    flex: 1;
  }

  .cat-meta {
    margin: 6px 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .count-badge {
    display: inline-block;
    padding: 3px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-purple-50);
    color: var(--color-purple-600);
    font-size: 0.78rem;
    font-weight: 700;
    border: 1px solid var(--color-purple-100);
  }

  .cat-cta {
    color: var(--color-pink-600);
    font-weight: 700;
    font-size: 0.92rem;
  }
</style>
