---
import Layout from '../../../layouts/Layout.astro';
import NsbvaGrid from '../../../components/NsbvaGrid.tsx';

const base = import.meta.env.BASE_URL;
const manifestUrl = `${base.replace(/\/$/, '')}/data/scenes_nsbva.json`;
---

<Layout title="NSBVA Previews">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`${base}/scenes/`}>Scenes</a>
      <span aria-hidden="true">›</span>
      <span>NSBVA Previews</span>
    </p>
    <h1>NSBVA Previews ✦</h1>
    <p class="lede">
      NSBVA is the DS visibility-bone-animation format — the format the game
      uses to flip individual mesh shapes on and off across frames, so an
      object can blink, flicker, open, or rotate without a full skeletal
      animation. Each card here is one NSBVA entry, played back as an
      animated APNG, with a contact-strip below showing every frame at a
      glance. Filter by container to focus on rooms, items, NPCs, etc.
    </p>
  </section>

  <NsbvaGrid
    client:load
    manifestUrl={manifestUrl}
    imagePrefix={`${base.replace(/\/$/, '')}/scenes/nsbva-previews`}
  />
</Layout>

<style>
  .page-header { padding: 40px 0 12px; }
  .breadcrumb {
    display: flex; gap: 8px; align-items: center;
    color: var(--color-ink-soft); font-size: 0.9rem; margin: 0 0 12px;
  }
  .breadcrumb a { color: var(--color-purple-400); font-weight: 600; }
  .lede { max-width: 70ch; line-height: 1.6; color: var(--color-ink); }
</style>
