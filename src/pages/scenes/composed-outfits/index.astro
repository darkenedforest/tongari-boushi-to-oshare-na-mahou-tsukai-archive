---
import Layout from '../../../layouts/Layout.astro';
import outfits from '../../../data/scenes_composed.json';

const base = import.meta.env.BASE_URL;
---

<Layout title="Composed Outfits">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`${base}/scenes/`}>Scenes</a>
      <span aria-hidden="true">›</span>
      <span>Composed Outfits</span>
    </p>
    <h1>Composed Outfits ✦</h1>
    <p class="lede">
      Sample player outfits assembled from the clothing pool. Each card
      shows the four equipment slots (top, bottom, hat, shoes) layered
      into one composed look, with the slot indices used to build it. The
      ROM doesn't store player save state, so these are illustrative
      combinations that demonstrate the outfit-composer pipeline working
      end-to-end against the actual clothing textures.
    </p>
  </section>

  <section class="grid">
    {outfits.map((o: any) => (
      <figure class="card">
        <div class="img-wrap">
          <img src={`${base}/scenes/composed-outfits/${o.file}`} alt={o.name} loading="lazy" />
        </div>
        <figcaption>
          <strong>{o.name}</strong>
          <p class="slots">
            top {o.top_idx} · bottom {o.bottom_idx} · hat {o.hat_idx} · shoes {o.shoes_idx}
          </p>
        </figcaption>
      </figure>
    ))}
  </section>
</Layout>

<style>
  .page-header { padding: 40px 0 12px; }
  .breadcrumb {
    display: flex; gap: 8px; align-items: center;
    color: var(--color-ink-soft); font-size: 0.9rem; margin: 0 0 12px;
  }
  .breadcrumb a { color: var(--color-purple-400); font-weight: 600; }
  .lede { max-width: 64ch; line-height: 1.6; color: var(--color-ink); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
    padding: 16px 0 60px;
  }

  .card {
    margin: 0;
    background: var(--surface-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-pink-100);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-pop);
  }

  .img-wrap {
    background: #1a1330;
    display: flex; justify-content: center;
    padding: 10px;
  }

  .img-wrap img {
    max-width: 100%;
    height: auto;
    image-rendering: -webkit-optimize-contrast;
  }

  figcaption {
    padding: 12px 14px 14px;
  }

  figcaption strong {
    color: var(--color-purple-600);
    font-size: 0.98rem;
  }

  .slots {
    margin: 4px 0 0;
    color: var(--color-ink-soft);
    font-size: 0.78rem;
    font-family: ui-monospace, monospace;
  }
</style>
