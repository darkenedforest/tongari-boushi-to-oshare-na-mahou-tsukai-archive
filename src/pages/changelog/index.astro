---
import Layout from '../../layouts/Layout.astro';
import v24meta from '../../data/changelog_v2.4_meta.json';
import v232meta from '../../data/changelog_v2.32_meta.json';
import v231 from '../../data/changelog_v2.31.json';
import v23meta from '../../data/changelog_v2.3_meta.json';
import v22meta from '../../data/changelog_v2.2_meta.json';
import v21meta from '../../data/changelog_v2.1_meta.json';
import v20meta from '../../data/changelog_v2.0_meta.json';

const base = import.meta.env.BASE_URL;

type ReleaseCard = {
  version: string;
  date: string;
  href: string;
  headline?: string;
  totalChanges?: number;
  isLatest?: boolean;
};

const releases: ReleaseCard[] = [
  {
    version: v24meta.version,
    date: v24meta.date,
    href: `${base}/changelog/v2.4/`,
    headline: v24meta.headline,
    totalChanges:
      v24meta.counts.magicInputTiles +
      v24meta.counts.npcDialogRows +
      v24meta.counts.cookingNarrationFragments +
      v24meta.counts.recipeMenuLabels +
      v24meta.counts.songTitleRevisions +
      v24meta.counts.melissaTypographyEdits +
      v24meta.counts.wizardRankReverts +
      v24meta.counts.deferredCleanupRows +
      v24meta.counts.nikomiContextEdits +
      v24meta.counts.charliesNoodlesCapFix,
    isLatest: true,
  },
  {
    version: v232meta.version,
    date: v232meta.date,
    href: `${base}/changelog/v2.32/`,
    headline: v232meta.headline,
    totalChanges:
      v232meta.counts.msgEdits +
      v232meta.counts.bulletinTitleEdits +
      v232meta.counts.answerListOpcodeFix +
      v232meta.counts.wizardRankCanonEdits +
      v232meta.counts.npcTypographyEdits,
  },
  {
    version: v231.version,
    date: v231.date,
    href: `${base}/changelog/v2.31/`,
    headline: v231.headline,
    totalChanges:
      v231.msgFileEdits.entries.length +
      v231.songRetranslations.entries.length +
      v231.overlayEdits.groups.reduce(
        (n: number, g: any) => n + g.rows.length,
        0,
      ),
  },
  {
    version: v23meta.version,
    date: v23meta.date,
    href: `${base}/changelog/v2.3/`,
    headline: v23meta.headline,
    totalChanges:
      v23meta.counts.msgEdits +
      v23meta.counts.itemNameEdits +
      v23meta.counts.overlayEdits,
  },
  {
    version: v22meta.version,
    date: v22meta.date,
    href: `${base}/changelog/v2.2/`,
    headline: v22meta.headline,
    totalChanges: v22meta.counts.msgEdits + v22meta.counts.itemNameEdits,
  },
  {
    version: v21meta.version,
    date: v21meta.date,
    href: `${base}/changelog/v2.1/`,
    headline: v21meta.headline,
    totalChanges: v21meta.counts.msgEdits + v21meta.counts.itemNameEdits,
  },
  {
    version: v20meta.version,
    date: v20meta.date,
    href: `${base}/changelog/v2.0/`,
    headline: v20meta.headline,
    totalChanges: v20meta.counts.msgEdits + v20meta.counts.itemNameEdits,
  },
];

function formatDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Layout title="Changelog">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>Changelog</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/butterfly-yellow.png`} alt="" />
      <img src={`${base}/decorations/magic-lamp-crystal.png`} alt="" />
      <img src={`${base}/decorations/dragonfly.png`} alt="" />
    </div>
    <h1>Changelog ✦</h1>
    <p class="lede">
      Row-by-row before/after diffs for every translation patch release —
      every <code>msg</code> file entry, item name, overlay string, and
      ARM9 byte that changed. Built for contributors and power users
      who want to see exactly what moved. For the "what's new" summary
      of each release, head to <a href={`${base}/patches/`}>Patches</a>.
    </p>
  </section>

  <section class="releases">
    <ul class="release-list">
      {releases.map((r) => (
        <li>
          <a href={r.href} class="release-card">
            <div class="release-left">
              <span class="version-tag">v{r.version}</span>
              {r.isLatest && <span class="latest-chip">Latest</span>}
              <time datetime={r.date}>{formatDate(r.date)}</time>
            </div>
            <div class="release-mid">
              {r.headline && <span class="headline">{r.headline}</span>}
              {typeof r.totalChanges === 'number' && (
                <span class="count">
                  {r.totalChanges.toLocaleString()} change{r.totalChanges === 1 ? '' : 's'}
                </span>
              )}
            </div>
            <span class="cta">View full diff <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="older-note">
      Detail pages for v2.0 through v2.3 were reconstructed from the
      shipped <code>.xdelta</code> patches by applying each one to the
      Japanese source ROM, extracting every <code>msg</code> /
      <code>onemsg</code> RESO container and item-name slot, and diffing
      against the previous release. Row data for these older releases
      can be several MB and is fetched on demand.
    </p>
  </section>
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }
  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }
  .header-sprites {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 6px 0 4px;
    opacity: 0.78;
  }
  .header-sprites img {
    width: 40px;
    height: 40px;
  }
  .header-sprites img:nth-child(2) {
    width: 48px;
    height: 48px;
  }
  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .lede code {
    background: var(--color-purple-50);
    padding: 1px 6px;
    border-radius: 6px;
    font-family: ui-monospace, monospace;
    font-size: 0.88em;
  }

  .releases {
    margin: 24px 0 50px;
  }

  .release-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .release-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 20px;
    padding: 22px 26px;
    background: var(--surface-strong);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-pink-100);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .release-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-pop);
    border-color: var(--color-pink-200);
    color: var(--color-ink);
  }

  .release-left {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .release-mid {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .release-mid .headline {
    color: var(--color-ink);
    font-size: 0.95rem;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .release-mid .count {
    color: var(--color-purple-600);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 720px) {
    .release-card {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  .version-tag {
    display: inline-block;
    padding: 5px 14px;
    background: linear-gradient(135deg, var(--color-pink-400), var(--color-purple-400));
    color: white;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 12px rgba(155, 123, 217, 0.25);
  }

  .latest-chip {
    display: inline-block;
    padding: 3px 10px;
    background: white;
    color: var(--color-pink-600);
    font-weight: 700;
    font-size: 0.72rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-pink-200);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  time {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    font-weight: 600;
  }

  .cta {
    font-weight: 700;
    color: var(--color-pink-600);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .older-note {
    margin: 28px 0 0;
    padding: 14px 18px;
    background: var(--color-purple-50);
    border: 1px solid var(--color-purple-100);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-size: 0.92rem;
    line-height: 1.55;
    max-width: 720px;
  }
</style>
