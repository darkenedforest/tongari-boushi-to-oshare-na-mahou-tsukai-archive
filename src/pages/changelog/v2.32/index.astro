---
import Layout from '../../../layouts/Layout.astro';
import ChangelogDetail from '../../../components/ChangelogDetail.tsx';
import data from '../../../data/changelog_v2.32.json';

const base = import.meta.env.BASE_URL;

function formatDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

const totalOther = data.otherChanges?.length ?? 0;
const totalRows = totalOther;
---

<Layout title={`Changelog · v${data.version}`}>
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`${base}/changelog/`}>Changelog</a>
      <span aria-hidden="true">›</span>
      <span>v{data.version}</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/butterfly-yellow.png`} alt="" />
      <img src={`${base}/decorations/magic-lamp-crystal.png`} alt="" />
      <img src={`${base}/decorations/dragonfly.png`} alt="" />
    </div>
    <div class="title-row">
      <h1>v{data.version} <span class="sparkle-mark" aria-hidden="true">✦</span></h1>
      <time datetime={data.date}>{formatDate(data.date)}</time>
    </div>
    <p class="lede">
      v{data.version} is a developer-pipeline overhaul, not a gameplay
      update. The patched in-game text is byte-for-byte identical to
      v2.31. For the release summary and the patch download, see the
      <a href={`${base}/patches/`}>Patches page</a>.
    </p>
    <p class="counters">
      <span><strong>{totalRows}</strong> documented changes</span>
      <span class="dot">·</span>
      <span>0 in-game text changes vs v2.31</span>
    </p>
    <p class="back-link">
      <a href={`${base}/changelog/`}>← Back to changelog index</a>
    </p>
  </section>

  <ChangelogDetail
    data={data as any}
    beforeLabel="v2.31"
    afterLabel="v2.32"
    client:load
  />
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }
  .header-sprites {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 6px 0 4px;
    opacity: 0.78;
  }
  .header-sprites img {
    width: 40px;
    height: 40px;
  }
  .header-sprites img:nth-child(2) {
    width: 48px;
    height: 48px;
  }
  .title-row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    flex-wrap: wrap;
    margin: 0 0 8px;
  }
  .title-row h1 {
    margin: 0;
  }
  .title-row time {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .sparkle-mark {
    color: var(--color-pink-400);
  }
  .lede {
    max-width: 72ch;
    line-height: 1.6;
    color: var(--color-ink);
  }
  .counters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 8px 0 4px;
  }
  .counters strong {
    color: var(--color-purple-600);
  }
  .counters .dot {
    opacity: 0.5;
  }
  .back-link {
    margin: 14px 0 0;
    font-size: 0.92rem;
  }
  .back-link a {
    color: var(--color-purple-400);
    font-weight: 600;
    text-decoration: none;
  }
  .back-link a:hover {
    color: var(--color-pink-600);
  }
</style>
