---
import Layout from '../../layouts/Layout.astro';
import SubscribeSeal from '../../components/SubscribeSeal.astro';
import patchData from '../../../public/data/patches.json';

const base = import.meta.env.BASE_URL;

const releases = patchData.releases;
const latest = releases[0];
const olderReleases = releases.slice(1);
const legacy = patchData.legacy;
const patcher = patchData.patcherInfo;

// Rotating sprite list for older release cards (purely decorative).
const olderSprites = [
  'parfait',
  'butterfly-yellow',
  'key',
  'crown',
  'magic-lamp-tall',
  'turtle',
  'grapes',
  'pizza',
];

function formatDate(iso: string): string {
  const d = new Date(iso + 'T00:00:00Z');
  return d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
}

function formatBytes(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
}

function resolveUrl(d: { url: string; isLocal?: boolean }): string {
  if (d.isLocal) {
    // strip leading slash so the base url joins cleanly
    const trimmed = d.url.replace(/^\/+/, '');
    return `${base}/${trimmed}`;
  }
  return d.url;
}

function resolveLocalUrl(path: string): string {
  const trimmed = path.replace(/^\/+/, '');
  return `${base}/${trimmed}`;
}

// ── In-browser patcher config ─────────────────────────────────────────
// Build the list of versions the web patcher can apply: only releases whose
// downloads are locally-hosted .xdelta files (v2.3 → latest). Each version
// carries its two ROM-revision entries (Rev 0 / Rev 1) so the patcher can
// auto-detect which revision the visitor's ROM is by MD5.
const webPatcherVersions = releases
  .filter((r) => r.downloads.some((d: any) => d.isLocal))
  .map((r) => {
    const revs = r.downloads
      .filter((d: any) => d.isLocal)
      .map((d: any) => ({
        label: d.label, // "Rev 0" / "Rev 1"
        file: resolveLocalUrl(d.url),
        inputMd5: d.romMd5,
      }));
    return {
      version: r.version,
      // Resulting patched-ROM sha256 (when known) lets us self-verify in dev.
      patchedRomSha256: r.patchedRomSha256 ?? null,
      outputName: `Tongari Boushi to Oshare na Mahou Tsukai (English v${r.version})`,
      revs,
    };
  });

const webPatcherConfig = {
  romPatcherBase: `${base}/rom-patcher-js/`,
  webappScript: `${base}/rom-patcher-js/RomPatcher.webapp.js`,
  styleSheet: `${base}/rom-patcher-js/style.css`,
  poweredByImg: `${base}/rom-patcher-js/assets/powered_by_rom_patcher_js.png`,
  versions: webPatcherVersions,
};

// Render very light markdown: **bold** spans only.
function renderInline(text: string): Array<{ kind: 'text' | 'bold'; value: string }> {
  const parts: Array<{ kind: 'text' | 'bold'; value: string }> = [];
  const re = /\*\*([^*]+)\*\*/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text)) !== null) {
    if (m.index > last) parts.push({ kind: 'text', value: text.slice(last, m.index) });
    parts.push({ kind: 'bold', value: m[1] });
    last = re.lastIndex;
  }
  if (last < text.length) parts.push({ kind: 'text', value: text.slice(last) });
  return parts;
}
---

<Layout title="Patches">
  <!-- RomPatcher.js stylesheet (vendored, MIT — marcrobledo/RomPatcher.js) -->
  <link
    rel="stylesheet"
    type="text/css"
    href={`${base}/rom-patcher-js/style.css`}
    media="all"
  />

  <section class="page-header">
    <div class="header-seal">
      <SubscribeSeal size="lg" />
    </div>
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>Patches</span>
    </p>
    <h1>Patches <span class="sparkle-mark" aria-hidden="true">✦</span></h1>
    <p class="lede">
      English fan-translation patches for the original Japanese DS ROM. The
      quickest way is the in-browser patcher just below — pick a version, drop
      in your ROM, done. If you'd rather patch manually, every
      <code>.xdelta</code> is also downloadable below for use with Delta Patcher.
    </p>
  </section>

  <!-- ───────────────────────── In-browser ROM patcher (hero) ────────────── -->
  <section class="web-patcher card" id="web-patcher" aria-labelledby="web-patcher-title">
    <div class="wp-banner">
      <div class="wp-glitter" aria-hidden="true">
        <span class="wp-star s1">✦</span>
        <span class="wp-star s2">✧</span>
        <span class="wp-star s3">✦</span>
        <span class="wp-star s4">✧</span>
        <span class="wp-star s5">✦</span>
        <span class="wp-star s6">✧</span>
      </div>
      <img
        class="wp-sprite"
        src={`${base}/decorations/magic-lamp-crystal.png`}
        alt=""
        aria-hidden="true"
      />
      <div class="wp-header">
        <span class="wp-recommend-chip">
          <span class="wp-chip-star" aria-hidden="true">✦</span> The easy way to patch
        </span>
        <h2 id="web-patcher-title">
          Patch your ROM in your browser
        </h2>
        <p class="wp-lede">
          No downloads, no extra tools. Pick a version, choose your Japanese
          <code>.nds</code> ROM, and get the English game back out — everything
          runs locally in your browser, and your ROM never leaves your device.
        </p>
      </div>
    </div>

    <div class="wp-controls">
      <label class="wp-field">
        <span class="wp-field-label">Patch version</span>
        <select id="wp-version-select" class="wp-select"></select>
      </label>
      <p class="wp-rev-hint">
        <strong>Rev 0 vs Rev 1:</strong> Rev 0 is the original cartridge dump;
        Rev 1 is Nintendo's later revision. You don't need to pick — the tool
        reads your ROM and selects the matching patch automatically, and warns
        you if the file isn't a recognized Japanese dump.
      </p>
    </div>

    <!-- RomPatcher.js container. The three IDs below are required by the
         webapp; the rest are informational. -->
    <div id="rom-patcher-container" class="wp-rompatcher">
      <div class="rom-patcher-row margin-bottom" id="rom-patcher-row-file-rom">
        <div class="text-right">
          <label for="rom-patcher-input-file-rom" data-localize="yes">ROM file:</label>
        </div>
        <div class="rom-patcher-container-input">
          <input type="file" id="rom-patcher-input-file-rom" class="empty" disabled />
        </div>
      </div>

      <div class="margin-bottom text-selectable text-mono text-muted" id="rom-patcher-rom-info">
        <div class="rom-patcher-row">
          <div class="text-right">CRC32:</div>
          <div class="text-truncate"><span id="rom-patcher-span-crc32"></span></div>
        </div>
        <div class="rom-patcher-row">
          <div class="text-right">MD5:</div>
          <div class="text-truncate"><span id="rom-patcher-span-md5"></span></div>
        </div>
        <div class="rom-patcher-row">
          <div class="text-right">SHA-1:</div>
          <div class="text-truncate"><span id="rom-patcher-span-sha1"></span></div>
        </div>
        <div class="rom-patcher-row" id="rom-patcher-row-info-rom">
          <div class="text-right">ROM:</div>
          <div class="text-truncate"><span id="rom-patcher-span-rom-info"></span></div>
        </div>
      </div>

      <!-- Patch selector: RomPatcher requires this element. We drive it via
           our own version dropdown + auto-rev-detection, so it stays a
           single, read-only entry showing the chosen patch. -->
      <div class="rom-patcher-row margin-bottom" id="rom-patcher-row-file-patch" hidden>
        <div class="text-right">
          <label for="rom-patcher-input-file-patch" data-localize="yes">Patch file:</label>
        </div>
        <div class="rom-patcher-container-input">
          <select id="rom-patcher-select-patch"></select>
        </div>
      </div>

      <div class="rom-patcher-row margin-bottom text-selectable text-mono text-muted" id="rom-patcher-row-patch-requirements">
        <div class="text-right text-mono" id="rom-patcher-patch-requirements-type">ROM requirements:</div>
        <div class="text-truncate" id="rom-patcher-patch-requirements-value"></div>
      </div>

      <div class="text-center" id="rom-patcher-row-apply">
        <div id="rom-patcher-row-error-message" class="margin-bottom">
          <span id="rom-patcher-error-message"></span>
        </div>
        <button id="rom-patcher-button-apply" class="btn wp-apply" data-localize="yes" disabled>
          Apply patch
        </button>
      </div>
    </div>

    <p class="wp-handoff">
      Prefer to patch offline? Grab a patch file and instructions below
      <span class="wp-handoff-arrow" aria-hidden="true">↓</span>
    </p>

    <p class="wp-powered">
      <a href="https://github.com/marcrobledo/RomPatcher.js" target="_blank" rel="noopener">
        Powered by RomPatcher.js
      </a>
    </p>
  </section>

  <!-- Patcher config consumed by the inline init script below. -->
  <script
    type="application/json"
    id="wp-config"
    is:inline
    set:html={JSON.stringify(webPatcherConfig)}
  />

  <!-- RomPatcher.js webapp (vendored, MIT). is:inline so Astro serves it
       verbatim from public/ rather than trying to bundle it. -->
  <script type="text/javascript" is:inline src={`${base}/rom-patcher-js/RomPatcher.webapp.js`}></script>

  <script is:inline>
    (function () {
      const cfg = JSON.parse(document.getElementById('wp-config').textContent);
      const versions = cfg.versions;
      const sel = document.getElementById('wp-version-select');

      // Populate the version dropdown (newest first; default = first/latest).
      versions.forEach(function (v, i) {
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = 'v' + v.version + (i === 0 ? ' (latest)' : '');
        sel.appendChild(opt);
      });

      let currentVersionIndex = 0;
      let currentRomMd5 = null; // md5 of the ROM the visitor loaded, if any

      // Pick the rev entry for a version: match the loaded ROM's md5 if we
      // have one; otherwise default to Rev 0.
      function pickRev(version) {
        if (currentRomMd5) {
          const m = version.revs.find(function (r) {
            return r.inputMd5.toLowerCase() === currentRomMd5.toLowerCase();
          });
          if (m) return m;
        }
        return version.revs[0];
      }

      // Build the embeded-patch descriptor RomPatcher expects for a rev.
      // Validation is against THIS rev's md5 only — each rev's .xdelta is
      // source-specific, so a Rev 1 ROM must get the Rev 1 patch. If the
      // wrong rev is staged for the loaded ROM, validation fails (button
      // stays disabled) and onloadrom swaps in the correct rev, which then
      // re-validates and enables Apply. This keeps the staged patch and the
      // validated ROM in lockstep.
      function patchDescriptor(version, rev) {
        return {
          file: rev.file,
          name: 'v' + version.version + ' — ' + rev.label,
          outputName: version.outputName,
          outputExtension: 'nds',
          inputMd5: rev.inputMd5,
        };
      }

      function applyVersion(index) {
        currentVersionIndex = index;
        const version = versions[index];
        const rev = pickRev(version);
        RomPatcherWeb.setEmbededPatches(patchDescriptor(version, rev));
      }

      sel.addEventListener('change', function () {
        applyVersion(parseInt(this.value, 10) || 0);
      });

      function init() {
        RomPatcherWeb.initialize(
          {
            language: 'en',
            requireValidation: true,
            outputSuffix: false,
            // When the visitor loads a ROM, compute its md5 and (if it
            // matches the other revision of the selected version) swap to the
            // matching rev so the right patch is applied automatically.
            onloadrom: function (romFile) {
              try {
                currentRomMd5 = romFile.hashMD5();
              } catch (e) {
                currentRomMd5 = null;
              }
              const version = versions[currentVersionIndex];
              const rev = pickRev(version);
              // Only re-fetch if the auto-detected rev differs from what's
              // currently staged (avoids a redundant fetch on every load).
              if (rev && rev.file !== (window.__wpCurrentPatchFile || null)) {
                window.__wpCurrentPatchFile = rev.file;
                RomPatcherWeb.setEmbededPatches(patchDescriptor(version, rev));
              }
            },
          },
          patchDescriptor(versions[0], pickRev(versions[0]))
        );
        window.__wpCurrentPatchFile = pickRev(versions[0]).file;
      }

      if (document.readyState === 'complete') {
        init();
      } else {
        window.addEventListener('load', init);
      }
    })();
  </script>

  <section class="how-to card">
    <h2>Prefer to patch manually?</h2>
    <p class="muted" style="margin-top: -6px;">
      You don't need to — the in-browser patcher above does everything
      locally. But if you'd rather use a desktop tool, here's the Delta Patcher
      route.
    </p>
    <ol class="how-list">
      <li>
        <strong>Figure out which ROM revision you have.</strong>
        <p class="muted">Open a terminal in the folder with your ROM and run:</p>
        <pre class="codeblock" aria-label="Windows PowerShell command"><span class="code-tag">PowerShell</span><code>{patcher.romHashCommandWindows}</code></pre>
        <pre class="codeblock" aria-label="macOS / Linux command"><span class="code-tag">Mac / Linux</span><code>{patcher.romHashCommandUnix}</code></pre>
        <p class="muted small">Match the MD5 it prints against the hash next to each download below.</p>
      </li>
      <li>
        <strong>Grab Delta Patcher</strong> from
        <a href={patcher.tool.url} target="_blank" rel="noopener">romhacking.net</a>
        and install it.
      </li>
      <li>
        <strong>Apply the patch.</strong>
        <ul class="bare">
          <li>"Original file" → your ROM.</li>
          <li>"XDelta patch" → the <code>.xdelta</code> file you downloaded.</li>
          <li>Click "Apply patch".</li>
        </ul>
        <p class="muted small">A new patched <code>.nds</code> file shows up in the same folder. That's the one to load.</p>
      </li>
    </ol>
  </section>

  <section class="releases">
    <h2>Release history</h2>

    <article class="release latest">
      <img class="release-sprite" src={`${base}/decorations/magic-lamp-gold.png`} alt="" aria-hidden="true" />
      <header class="release-head">
        <div class="version-line">
          <span class="version-tag">v{latest.version}</span>
          <span class="latest-chip" aria-label="Latest release">Latest</span>
        </div>
        <time datetime={latest.date}>{formatDate(latest.date)}</time>
      </header>
      <h3 class="release-headline">{latest.headline}</h3>
      <p class="release-summary">{latest.summary}</p>

      <ul class="changes">
        {latest.changes.map((c) => <li>{c}</li>)}
      </ul>

      {latest.notes && (
        <p class="release-note">
          {renderInline(latest.notes).map((p) =>
            p.kind === 'bold' ? <strong>{p.value}</strong> : <span>{p.value}</span>
          )}
        </p>
      )}

      {latest.changelogUrl && (
        <p class="changelog-link">
          <a href={resolveLocalUrl(latest.changelogUrl)}>
            View detailed change log <span aria-hidden="true">→</span>
          </a>
        </p>
      )}

      <div class="downloads">
        <p class="downloads-label">Download</p>
        <div class="download-grid">
          {latest.downloads.map((d) => (
            <a
              class="download-card"
              href={resolveUrl(d)}
              {...(d.isLocal
                ? { download: '' }
                : { target: '_blank', rel: 'noopener' })}
            >
              <span class="download-label">
                {d.label}
                {d.patchSizeBytes && (
                  <span class="size-tag"> ({formatBytes(d.patchSizeBytes)})</span>
                )}
              </span>
              <span class="download-sub">Match this MD5:</span>
              <code class="hash">{d.romMd5}</code>
              <span class="download-cta">
                {d.isLocal ? 'Download .xdelta' : 'Open download'}{' '}
                <span aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
        {latest.revGuidance && (
          <p class="rev-guidance"><strong>Which Rev?</strong> {latest.revGuidance}</p>
        )}
        {(latest.patchSizeBytes || latest.patchSha256 || latest.patchedRomMd5) && (
          <div class="meta-grid">
            {latest.patchSizeBytes && (
              <p class="patched-hash">
                <span class="muted">Patch size:</span>{' '}
                <code class="hash inline">{formatBytes(latest.patchSizeBytes)}</code>
              </p>
            )}
            {latest.patchSha256 && (
              <p class="patched-hash">
                <span class="muted">Patch SHA-256:</span>{' '}
                <code class="hash inline">{latest.patchSha256}</code>
              </p>
            )}
            {latest.patchedRomMd5 && (
              <p class="patched-hash">
                <span class="muted">Patched ROM MD5:</span>{' '}
                <code class="hash inline">{latest.patchedRomMd5}</code>
              </p>
            )}
          </div>
        )}
      </div>
    </article>

    {olderReleases.length > 0 && (
      <div class="older">
        <h3 class="older-title">Older versions</h3>
        <div class="older-list">
          {olderReleases.map((r, idx) => (
            <article class="release older-release">
              <img class="release-sprite small" src={`${base}/decorations/${olderSprites[idx % olderSprites.length]}.png`} alt="" aria-hidden="true" />
              <header class="release-head">
                <div class="version-line">
                  <span class="version-tag muted-tag">v{r.version}</span>
                </div>
                <time datetime={r.date}>{formatDate(r.date)}</time>
              </header>
              <h4 class="release-headline">{r.headline}</h4>
              <p class="release-summary">{r.summary}</p>

              {r.changes.length > 0 && (
                <ul class="changes">
                  {r.changes.map((c) => <li>{c}</li>)}
                </ul>
              )}

              {r.changelogUrl && (
                <p class="changelog-link">
                  <a href={resolveLocalUrl(r.changelogUrl)}>
                    View detailed change log <span aria-hidden="true">→</span>
                  </a>
                </p>
              )}

              <div class="downloads">
                <div class="download-grid compact">
                  {r.downloads.map((d) => (
                    <a
                      class="download-card small"
                      href={resolveUrl(d)}
                      {...(d.isLocal
                        ? { download: '' }
                        : { target: '_blank', rel: 'noopener' })}
                    >
                      <span class="download-label">
                        {d.label}
                        {d.patchSizeBytes && (
                          <span class="size-tag"> ({formatBytes(d.patchSizeBytes)})</span>
                        )}
                      </span>
                      <code class="hash">{d.romMd5}</code>
                    </a>
                  ))}
                </div>
                {r.patchedRomMd5 && (
                  <p class="patched-hash">
                    <span class="muted">Patched ROM MD5:</span>{' '}
                    <code class="hash inline">{r.patchedRomMd5}</code>
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </section>

  {legacy && (
    <section class="legacy card">
      <h2>Before v2.0 — the old tool</h2>
      <p class="muted">
        <time datetime={legacy.date}>{formatDate(legacy.date)}</time>
      </p>
      <p>{legacy.summary}</p>
      <ul class="legacy-downloads">
        {legacy.downloads.map((d) => (
          <li>
            <a href={d.url} target="_blank" rel="noopener"><strong>{d.label}</strong></a>
            {d.description && <span class="muted"> — {d.description}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="source-note">
    Originally posted at{' '}
    <a href={patchData.source.origin} target="_blank" rel="noopener">
      tongariboushipatchtool.wordpress.com
    </a>.
  </p>
</Layout>

<style>
  .page-header {
    padding: 40px 0 12px;
    position: relative;
  }

  .header-seal {
    position: absolute;
    top: 26px;
    right: 0;
    z-index: 5;
  }

  @media (max-width: 1020px) {
    .header-seal {
      position: static;
      margin: 0 0 10px;
      text-align: center;
    }
  }

  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }

  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }

  .sparkle-mark {
    color: var(--color-pink-400);
  }

  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
    font-size: 1.05rem;
  }

  .lede code {
    background: var(--color-purple-50);
    padding: 1px 6px;
    border-radius: 6px;
    font-size: 0.9em;
  }

  /* How-to block */
  .how-to {
    margin: 24px 0 36px;
    padding: 28px 30px;
  }

  .how-to h2 {
    margin: 0 0 16px;
    font-size: 1.25rem;
  }

  .how-list {
    margin: 0;
    padding-left: 24px;
    display: grid;
    gap: 16px;
  }

  .how-list li {
    line-height: 1.55;
  }

  .how-list li strong {
    color: var(--color-purple-600);
  }

  .how-list .muted {
    margin: 6px 0;
    color: var(--color-ink-soft);
  }

  .how-list .small {
    font-size: 0.88rem;
  }

  .bare {
    list-style: disc;
    padding-left: 20px;
    margin: 6px 0;
  }

  .bare li {
    margin: 2px 0;
  }

  .codeblock {
    position: relative;
    margin: 8px 0;
    padding: 14px 16px 14px 132px;
    background: linear-gradient(135deg, var(--color-purple-50), var(--color-pink-50));
    border: 1px solid var(--color-purple-100);
    border-radius: var(--radius-md);
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.85rem;
    color: var(--color-ink);
    overflow-x: auto;
    white-space: pre;
  }

  .code-tag {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-purple-600);
    background: white;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-purple-100);
  }

  /* Releases */
  .releases {
    margin: 16px 0 36px;
  }

  .releases > h2 {
    margin: 12px 0 18px;
    font-size: 1.4rem;
  }

  .release {
    background: var(--surface-strong);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-pink-100);
    box-shadow: var(--shadow-soft);
    padding: 28px 30px;
    margin-bottom: 20px;
    position: relative;
  }

  .release.latest {
    border: 1px solid var(--color-pink-200);
    box-shadow: var(--shadow-pop);
    background:
      linear-gradient(180deg, rgba(255, 240, 246, 0.85), rgba(255, 255, 255, 1) 40%);
  }

  .release.latest::before {
    content: '';
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 4px;
    background: linear-gradient(90deg, var(--color-pink-400), var(--color-purple-400), var(--color-blue-400));
