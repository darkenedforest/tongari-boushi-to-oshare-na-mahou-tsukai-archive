---
import Layout from '../layouts/Layout.astro';
import HomeBadges from '../components/HomeBadges.astro';
import GameCart from '../components/GameCart.astro';
import patch3ds from '../../public/data/patches_3ds.json';
import { GAMES } from '../data/games';
const base = import.meta.env.BASE_URL;
const g3 = GAMES['3ds'];
const has3dsRelease = ((patch3ds as any).releases ?? []).length > 0;
---

<Layout title="Home">
  <section class="hero">
    <div class="hero-text">
      <div class="hero-top">
        <h1>The Archives ✦</h1>
        <HomeBadges part="sticker" />
      </div>
      <p class="lede">
        I'm working on an English fan translation of this Japan-only DS game.
        A lot of that work involves pulling the game open and finding what's
        inside — files, art, dialog, characters. This is where the pieces I
        uncover end up, so I can come back to them and so anyone else who's
        curious can poke around.
      </p>
      <div class="hero-discord">
        <HomeBadges part="discord" />
      </div>
    </div>
    <div class="hero-decoration" aria-hidden="true">
      <img class="title-castle" src={`${base}/decorations/title_castle_day.png`} alt="" />
    </div>
  </section>

  <!-- 3DS game announcement -->
  <a class="announce" href={`${base}/patches/#3ds`}
     style={`--a-deep:${g3.accent.deep};--a-mid:${g3.accent.mid};--a-light:${g3.accent.light};--a-ink:${g3.accent.ink}`}>
    <span class="announce-ribbon">New</span>
    <div class="announce-carts" aria-hidden="true">
      <div class="ac ac-ds"><GameCart game="ds" width={118} tilt={-12} /></div>
      <div class="ac ac-3ds"><GameCart game="3ds" width={132} tilt={7} /></div>
    </div>
    <div class="announce-text">
      <p class="announce-kicker">News ✦</p>
      <h2>The 3DS game has patches too!</h2>
      <p>
        {has3dsRelease
          ? <><span lang="ja">{g3.titleJa}</span> now has fan translation patches in Italian and English!</>
          : <><span lang="ja">{g3.titleJa}</span> is getting a multilingual fan translation, starting with Italian. We'll let you know when it's ready to play!</>}
      </p>
      <span class="announce-cta">See the 3DS patch page <span aria-hidden="true">→</span></span>
    </div>
  </a>

  <div class="section-divider" aria-hidden="true">
    <img src={`${base}/decorations/peach.png`} alt="" />
    <img src={`${base}/decorations/parfait.png`} alt="" />
    <img src={`${base}/decorations/lemon.png`} alt="" />
  </div>

  <section class="sections">
    <div class="section-grid">
      <a href={`${base}/patches/`} class="section-card live">
        <span class="section-emoji">💾</span>
        <h3>Patches</h3>
        <p>Fan-translation patches for both games: the English DS patch with its full release history, MD5 hashes and in-browser patcher, and the Italian and English 3DS patches.</p>
        <span class="section-cta">Latest release →</span>
      </a>
      <a href={`${base}/assets/`} class="section-card live">
        <span class="section-emoji">🖼️</span>
        <h3>2D Assets</h3>
        <p>Item icons, NPC sprites, magic keyboard glyphs, shop screens, title art — plus the composed reference shots: NPC roster cards, pet life-stage charts, recipe flows, animated NSBVA furniture, outfit composites, hair and magazine catalogs.</p>
        <span class="section-cta">Browse →</span>
      </a>
      <a href={`${base}/field-guide/`} class="section-card live">
        <span class="section-emoji">📖</span>
        <h3>Field Guide</h3>
        <p>What I've found inside the game — how the files are laid out, how the dialog system works, where the art lives, and the translation canon I'm working from.</p>
        <span class="section-cta">Read →</span>
      </a>
      <a href={`${base}/3d-models/`} class="section-card live">
        <span class="section-emoji">🪄</span>
        <h3>3D Models</h3>
        <p>Every 3D model in the game — clothing, NPCs, furniture, caught bugs, environment, magic effects. Spin them in a browser-based viewer with orbit, zoom, and animation playback.</p>
        <span class="section-cta">Open viewer →</span>
      </a>
      <a href={`${base}/translation/`} class="section-card live">
        <span class="section-emoji">💬</span>
        <h3>Translation</h3>
        <p>Browse the in-progress fan translation side-by-side with the original Japanese, across the entire ROM. The English ships pre-loaded; the Japanese is parsed locally from your own copy of the NDS ROM, nothing uploaded.</p>
        <span class="section-cta">Open viewer →</span>
      </a>
      <a href={`${base}/changelog/`} class="section-card live">
        <span class="section-emoji">📜</span>
        <h3>Changelog</h3>
        <p>Every release of the patch, what changed in it, and a per-version detail page with before/after for every translation tweak that shipped.</p>
        <span class="section-cta">See versions →</span>
      </a>
      <a href={`${base}/bug-reports/`} class="section-card live">
        <span class="section-emoji">🐛</span>
        <h3>Bug Reports</h3>
        <p>The public triage board for both patches and the site, filterable by game. Open reports, screenshots, "Me too" counts, and workaround comments — no account needed to post or pile on.</p>
        <span class="section-cta">Open the board →</span>
      </a>
      <a href={`${base}/save-files/`} class="section-card live">
        <span class="section-emoji">💾</span>
        <h3>Save Files</h3>
        <p>In-browser editor for Tongari Boushi save files. Tweak Ritch, your player name, school name, mail, and the 15-slot inventory bag, then download a modified copy. Checksums are recomputed automatically so the patched save loads cleanly.</p>
        <span class="section-cta">Open the editor →</span>
      </a>
      <a href={`${base}/guest-book/`} class="section-card live">
        <span class="section-emoji">💌</span>
        <h3>Guest Book</h3>
        <p>Sign the guest book with a card you make yourself — draw pixel art, type a note, stamp on real sprites from the game, and pick a background. Every visitor's card goes up on the wall.</p>
        <span class="section-cta">Make your card →</span>
      </a>
      <a href={`${base}/apps/`} class="section-card live">
        <span class="section-emoji">📱</span>
        <h3>Apps</h3>
        <p>A couple of little Android apps I built for myself while learning Japanese — including YappyJappy, a chat partner that sets furigana over every kanji, corrects your sentences, and glosses the hard words. Free sideload downloads.</p>
        <span class="section-cta">Browse the apps →</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .announce {
    position: relative;
    display: grid;
    grid-template-columns: 250px 1fr;
    align-items: center;
    gap: 26px;
    margin: 8px 0 34px;
    padding: 26px 30px 26px 16px;
    background: linear-gradient(120deg, var(--a-light) 0%, #fff 55%, #ffe9f4 100%);
    border: 3px solid var(--a-deep);
    box-shadow: 7px 7px 0 var(--a-deep);
    color: var(--color-ink);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .announce:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 9px 0 var(--a-deep);
    color: var(--color-ink);
  }
  .announce-ribbon {
    position: absolute;
    top: 14px;
    right: -34px;
    width: 130px;
    padding: 3px 0;
    transform: rotate(35deg);
    background: var(--a-deep);
    color: #fff;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .announce-carts {
    position: relative;
    height: 150px;
  }
  .ac { position: absolute; }
  .ac-ds { left: 6px; top: 14px; z-index: 1; }
  .ac-3ds { left: 98px; top: 0; z-index: 2; }
  .announce-cta {
    display: inline-block;
    padding: 6px 14px;
    background: var(--a-deep);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    box-shadow: 3px 3px 0 var(--a-ink);
  }
  .announce-kicker {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--a-deep);
  }
  .announce h2 {
    margin: 0 0 8px;
    color: var(--a-ink);
    font-size: 1.6rem;
  }
  .announce-text p:not(.announce-kicker) {
    margin: 0 0 12px;
    line-height: 1.6;
  }
  @media (max-width: 680px) {
    .announce { grid-template-columns: 1fr; padding: 20px 18px; gap: 10px; }
    .announce-carts { width: 250px; margin: 0 auto; }
  }

  .hero {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 60px 0 40px;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .hero-top {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .hero-top h1 {
    margin: 0;
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 56ch;
  }

  .hero-discord {
    margin: 18px 0 0;
    max-width: 56ch;
    display: flex;
    justify-content: center;
  }

  .hero-decoration {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(155, 123, 217, 0.25);
    border: 3px solid var(--color-pink-200);
  }

  .title-castle {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
  }

  .section-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    padding: 8px 0 4px;
    opacity: 0.7;
  }

  .section-divider img {
    width: 44px;
    height: 44px;
    image-rendering: auto;
  }

  .section-divider img:nth-child(2) {
    width: 56px;
    height: 56px;
  }

  .sections {
    padding: 30px 0 50px;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .section-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--surface-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-pink-100);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .section-card.live {
    cursor: pointer;
  }

  .section-card.live:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pop);
    border-color: var(--color-pink-200);
  }

  .section-card.more {
    opacity: 0.72;
    cursor: default;
  }

  .section-emoji {
    font-size: 2rem;
  }

  .section-card h3 {
    margin: 0;
  }

  .section-card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .section-cta {
    margin-top: auto;
    font-weight: 700;
    color: var(--color-pink-600);
  }
</style>
