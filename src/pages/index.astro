---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Home">
  <section class="hero">
    <div class="hero-text">
      <h1>The Pointed-Hat Archive ✦</h1>
      <p class="lede">
        A fan-built reference for <em>Tongari Boushi to Oshare na Mahou Tsukai</em> — every
        in-game asset, opened up, organized, and (eventually) browseable from
        anywhere. Magic glyph buttons, NPC portraits, item icons, shop screens,
        title art — all of it.
      </p>
      <div class="hero-cta">
        <a href={`${base}/assets/`} class="btn">Browse the assets</a>
        <a href="https://github.com/darkenedforest/tongari-boushi-to-oshare-na-mahou-tsukai-archive" class="btn btn-secondary" target="_blank" rel="noopener">View on GitHub</a>
      </div>
    </div>
    <div class="hero-decoration" aria-hidden="true">
      <div class="hat">🎩</div>
      <div class="sparkle s1">✦</div>
      <div class="sparkle s2">✧</div>
      <div class="sparkle s3">✦</div>
      <div class="sparkle s4">✧</div>
    </div>
  </section>

  <section class="sections">
    <h2>Sections</h2>
    <div class="section-grid">
      <a href={`${base}/assets/`} class="section-card live">
        <span class="section-emoji">🖼️</span>
        <h3>2D Assets</h3>
        <p>Item icons, NPC sprites, magic keyboard glyphs, shop screens, title art — every 2D image in the game, with palette and source-container metadata.</p>
        <span class="section-cta">Browse →</span>
      </a>
      <div class="section-card pending">
        <span class="section-emoji">💬</span>
        <h3>Dialog Paths</h3>
        <p>Searchable conversation trees by character, location, and event. <em>Coming soon.</em></p>
      </div>
      <div class="section-card pending">
        <span class="section-emoji">🧚</span>
        <h3>3D Models</h3>
        <p>NPC and creature models with rotation, animation playback, and texture inspection. <em>Coming soon.</em></p>
      </div>
      <div class="section-card pending">
        <span class="section-emoji">🗺️</span>
        <h3>Maps</h3>
        <p>Interactive town and dungeon maps with NPC pin locations and shop overlays. <em>Coming soon.</em></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 60px 0 40px;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 56ch;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .hero-decoration {
    position: relative;
    aspect-ratio: 1;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 213, 232, 0.7) 45%,
      rgba(202, 179, 255, 0.4) 70%,
      transparent 100%
    );
    border-radius: var(--radius-lg);
  }

  .hat {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 6rem;
    filter: drop-shadow(0 8px 16px rgba(155, 123, 217, 0.35));
  }

  .sparkle {
    position: absolute;
    color: var(--color-pink-400);
    font-size: 1.8rem;
    text-shadow: 0 2px 6px rgba(255, 126, 182, 0.4);
  }

  .s1 { top: 12%; left: 22%; }
  .s2 { top: 18%; right: 18%; font-size: 1.2rem; color: var(--color-purple-400); }
  .s3 { bottom: 22%; left: 14%; font-size: 1.4rem; color: var(--color-blue-400); }
  .s4 { bottom: 16%; right: 24%; }

  .sections {
    padding: 30px 0 50px;
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }

  .section-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--surface-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-pink-100);
    text-decoration: none;
    color: var(--color-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .section-card.live {
    cursor: pointer;
  }

  .section-card.live:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-pop);
    border-color: var(--color-pink-200);
  }

  .section-card.pending {
    opacity: 0.72;
  }

  .section-emoji {
    font-size: 2rem;
  }

  .section-card h3 {
    margin: 0;
  }

  .section-card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .section-cta {
    margin-top: auto;
    font-weight: 700;
    color: var(--color-pink-600);
  }
</style>
