---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Home">
  <section class="hero">
    <div class="hero-text">
      <h1>The Pointed-Hat Archive ✦</h1>
      <p class="lede">
        A fan-built reference for <em>Tongari Boushi to Oshare na Mahou Tsukai</em> — every
        in-game asset, opened up, organized, and (eventually) browseable from
        anywhere. Magic glyph buttons, NPC portraits, item icons, shop screens,
        title art — all of it.
      </p>
      <div class="hero-cta">
        <a href={`${base}/assets/`} class="btn">Browse the assets</a>
      </div>
    </div>
    <div class="hero-decoration" aria-hidden="true">
      <div class="hat">🎩</div>
      <div class="sparkle s1">✦</div>
      <div class="sparkle s2">✧</div>
      <div class="sparkle s3">✦</div>
      <div class="sparkle s4">✧</div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 60px 0 40px;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .lede {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 56ch;
  }

  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  .hero-decoration {
    position: relative;
    aspect-ratio: 1;
    background: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.95) 0%,
      rgba(255, 213, 232, 0.7) 45%,
      rgba(202, 179, 255, 0.4) 70%,
      transparent 100%
    );
    border-radius: var(--radius-lg);
  }

  .hat {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 6rem;
    filter: drop-shadow(0 8px 16px rgba(155, 123, 217, 0.35));
  }

  .sparkle {
    position: absolute;
    color: var(--color-pink-400);
    font-size: 1.8rem;
    text-shadow: 0 2px 6px rgba(255, 126, 182, 0.4);
  }

  .s1 { top: 12%; left: 22%; }
  .s2 { top: 18%; right: 18%; font-size: 1.2rem; color: var(--color-purple-400); }
  .s3 { bottom: 22%; left: 14%; font-size: 1.4rem; color: var(--color-blue-400); }
  .s4 { bottom: 16%; right: 24%; }
</style>
