---
import Layout from '../../layouts/Layout.astro';
import AssetGallery from '../../components/AssetGallery.tsx';

// Manifest is loaded client-side from /data/manifest.json so the
// page stays static and the gallery only fetches data when visited.
const base = import.meta.env.BASE_URL;
---

<Layout title="2D Assets">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>2D Assets</span>
    </p>
    <h1>2D Assets ✦</h1>
    <p class="lede">
      Every 2D image extracted from the game, organized by source container.
      Filter by category, click a tile to see the full image, palette source,
      and source filesystem path.
    </p>
  </section>

  <AssetGallery client:load manifestUrl={`${base}/data/manifest.json`} />
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }

  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }

  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }

  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
  }
</style>
