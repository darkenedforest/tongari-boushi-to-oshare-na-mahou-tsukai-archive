---
import Layout from '../../layouts/Layout.astro';
import AssetGallery from '../../components/AssetGallery.tsx';

// Manifest is loaded client-side from /data/manifest.json so the
// page stays static and the gallery only fetches data when visited.
const base = import.meta.env.BASE_URL;
---

<Layout title="2D Assets">
  <section class="page-header">
    <p class="breadcrumb">
      <a href={`${base}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <span>2D Assets</span>
    </p>
    <div class="header-sprites" aria-hidden="true">
      <img src={`${base}/decorations/butterfly-yellow.png`} alt="" />
      <img src={`${base}/decorations/crown.png`} alt="" />
      <img src={`${base}/decorations/peach.png`} alt="" />
      <img src={`${base}/decorations/magic-lamp-crystal.png`} alt="" />
      <img src={`${base}/decorations/dragonfly.png`} alt="" />
    </div>
    <h1>2D Assets ✦</h1>
    <p class="lede">
      Magic-glyph keyboard buttons and item icons — what we've validated so far.
      More categories as they're cracked. Click any tile for the full image,
      palette source, and the Japanese name from the game data.
    </p>
  </section>

  <AssetGallery client:load manifestUrl={`${base}/data/manifest.json`} />
</Layout>

<style>
  .page-header {
    padding: 40px 0 20px;
  }

  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }

  .breadcrumb a {
    color: var(--color-purple-400);
    font-weight: 600;
  }

  .lede {
    max-width: 64ch;
    line-height: 1.6;
    color: var(--color-ink);
  }

  .header-sprites {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 6px 0 4px;
    opacity: 0.78;
  }

  .header-sprites img {
    width: 40px;
    height: 40px;
  }

  .header-sprites img:nth-child(2),
  .header-sprites img:nth-child(4) {
    width: 48px;
    height: 48px;
  }
</style>
