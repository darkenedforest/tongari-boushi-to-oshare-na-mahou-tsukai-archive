---
const base = import.meta.env.BASE_URL;
const sections = [
  { label: 'Home', href: `${base}/` },
  { label: 'Patches', href: `${base}/patches/` },
  { label: '2D Assets', href: `${base}/assets/` },
  { label: 'Field Guide', href: `${base}/field-guide/` },
  { label: '3D Models', href: `${base}/3d-models/` },
  { label: 'Translation', href: `${base}/translation/` },
  { label: 'Changelog', href: `${base}/changelog/` },
  { label: 'Bug Reports', href: `${base}/bug-reports/` },
  { label: 'Save Files', href: `${base}/save-files/` },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const baseNorm = base.replace(/\/$/, '');
---

<header class="site-header">
  <div class="container header-brand-row">
    <a href={`${base}/`} class="brand">
      <span class="brand-hat" aria-hidden="true">🎩</span>
      <span class="brand-text">
        <span class="brand-title">Tongari Boushi</span>
        <span class="brand-subtitle">to Oshare na Mahou Tsukai — Archive</span>
      </span>
    </a>
  </div>
  <nav class="site-nav" aria-label="Primary">
    <div class="nav-inner">
      <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-hidden="true" tabindex="-1" />
      <label for="nav-toggle" class="nav-toggle" aria-label="Toggle navigation">
        <span class="nav-toggle-bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="nav-toggle-label">Menu</span>
      </label>
      <ul class="nav-list">
        {sections.map(s => {
          const norm = s.href.replace(/\/$/, '');
          // Home matches only the bare base; section roots match themselves + subpaths
          const active = norm === baseNorm
            ? current === baseNorm
            : current === norm || current.startsWith(norm + '/');
          return (
            <li>
              <a href={s.href} class:list={['nav-link', { active }]}>{s.label}</a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(180deg, rgba(255, 240, 246, 0.92), rgba(245, 240, 255, 0.85));
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-pink-100);
  }

  .header-brand-row {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 16px;
    padding-bottom: 10px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .brand-hat {
    font-size: 1.9rem;
    filter: drop-shadow(0 2px 4px rgba(155, 123, 217, 0.3));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    text-align: left;
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--color-pink-600);
    letter-spacing: 0.01em;
  }

  .brand-subtitle {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    font-weight: 600;
    margin-top: 2px;
  }

  /* Nav row spans the full viewport width, with the link strip itself
     centered inside the .container max width. */
  .site-nav {
    width: 100%;
    border-top: 1px solid rgba(255, 174, 206, 0.35);
    background: linear-gradient(180deg, rgba(255, 240, 246, 0.55), rgba(245, 240, 255, 0.45));
    padding-bottom: 6px;
  }

  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 6px 24px 4px;
  }

  /* CSS-only collapse: hidden checkbox drives a sibling :checked selector
     to expand the list on mobile. The toggle label is the visible
     hamburger pill. No <details>, no JS. */
  .nav-toggle-checkbox {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface-strong);
    color: var(--color-purple-600);
    font-weight: 700;
    cursor: pointer;
    width: fit-content;
    border: 1px solid var(--color-purple-100);
    box-shadow: var(--shadow-soft);
    user-select: none;
  }

  .nav-toggle-bars {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 3px;
    width: 18px;
    height: 14px;
  }

  .nav-toggle-bars span {
    display: block;
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, var(--color-pink-400), var(--color-purple-400));
    border-radius: 2px;
  }

  /* Desktop default: list is always a horizontal flex strip. */
  .nav-list {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 4px 0 6px;
  }

  .nav-link {
    display: inline-block;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    color: var(--color-ink-soft);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-link:hover {
    background: var(--color-purple-100);
    color: var(--color-purple-600);
  }

  .nav-link.active {
    background: linear-gradient(135deg, var(--color-pink-400), var(--color-purple-400));
    color: white;
  }

  /* Mobile: show the hamburger label, collapse the list under it.
     :checked sibling selector expands. */
  @media (max-width: 720px) {
    .header-brand-row {
      padding-top: 12px;
      padding-bottom: 8px;
    }

    .brand-title {
      font-size: 1.15rem;
    }

    .brand-subtitle {
      font-size: 0.7rem;
    }

    .nav-inner {
      padding: 6px 16px 10px;
    }

    .nav-toggle {
      display: inline-flex;
    }

    .nav-list {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding: 10px 0 4px;
    }

    .nav-toggle-checkbox:checked ~ .nav-list {
      display: flex;
    }

    .nav-toggle-checkbox:checked ~ .nav-toggle {
      background: linear-gradient(135deg, var(--color-pink-100), var(--color-purple-100));
    }

    .nav-list li {
      width: 100%;
    }

    .nav-link {
      display: block;
      text-align: center;
      padding: 10px 14px;
    }
  }
</style>
