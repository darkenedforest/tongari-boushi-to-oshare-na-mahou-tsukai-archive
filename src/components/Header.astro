---
const base = import.meta.env.BASE_URL;
const sections = [
  { label: 'Home', href: `${base}/` },
  { label: 'Patches', href: `${base}/patches/` },
  { label: '2D Assets', href: `${base}/assets/` },
  { label: 'Field Guide', href: `${base}/field-guide/` },
  { label: 'Bug Reports', href: `${base}/bug-reports/` },
];
const current = Astro.url.pathname.replace(/\/$/, '');
const baseNorm = base.replace(/\/$/, '');
---

<header class="site-header">
  <div class="container header-inner">
    <a href={`${base}/`} class="brand">
      <span class="brand-hat" aria-hidden="true">🎩</span>
      <span class="brand-text">
        <span class="brand-title">Tongari Boushi</span>
        <span class="brand-subtitle">to Oshare na Mahou Tsukai — Archive</span>
      </span>
    </a>
    <nav>
      <ul class="nav-list">
        {sections.map(s => {
          const norm = s.href.replace(/\/$/, '');
          // Home matches only the bare base; section roots match themselves + subpaths
          const active = norm === baseNorm
            ? current === baseNorm
            : current === norm || current.startsWith(norm + '/');
          return (
            <li>
              <a href={s.href} class:list={['nav-link', { active }]}>{s.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(180deg, rgba(255, 240, 246, 0.92), rgba(245, 240, 255, 0.85));
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-pink-100);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--color-ink);
  }

  .brand-hat {
    font-size: 1.6rem;
    filter: drop-shadow(0 2px 4px rgba(155, 123, 217, 0.3));
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .brand-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-pink-600);
    letter-spacing: 0.01em;
  }

  .brand-subtitle {
    font-size: 0.72rem;
    color: var(--color-ink-soft);
    font-weight: 600;
    margin-top: 2px;
  }

  .nav-list {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-block;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    color: var(--color-ink-soft);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-link:hover {
    background: var(--color-purple-100);
    color: var(--color-purple-600);
  }

  .nav-link.active {
    background: linear-gradient(135deg, var(--color-pink-400), var(--color-purple-400));
    color: white;
  }
</style>
