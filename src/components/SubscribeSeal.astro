---
// Gold-sticker subscribe seal + pop-up form. The seal is a starburst
// "quality seal" button; tapping it opens a <dialog> that collects an
// email into the Supabase `patch_subscribers` table (insert-only via the
// anon key — see SUPABASE_SETUP.md). Announcements are sent by
// scripts/send_patch_announcement.py when a release ships.
//
// Visiting any page with this component with #subscribe in the URL opens
// the pop-up automatically (announcement emails link there to unsubscribe).
interface Props {
  size?: 'lg' | 'md';
}
const { size = 'md' } = Astro.props;
const base = import.meta.env.BASE_URL;

// Starburst seal outline: 24 spikes on a 200x200 viewBox.
const points = Array.from({ length: 48 }, (_, i) => {
  const r = i % 2 === 0 ? 98 : 87;
  const a = (Math.PI * 2 * i) / 48 - Math.PI / 2;
  return `${(100 + r * Math.cos(a)).toFixed(2)},${(100 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');
---

<div class={`seal-cluster seal-${size}`} id="subscribe">
  <button
    class="seal-btn seal-gold-btn"
    id="psub-open"
    type="button"
    aria-haspopup="dialog"
    aria-label="Subscribe for patch update emails"
  >
    <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
      <defs>
        <linearGradient id="seal-gold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffe9a8" />
          <stop offset="0.45" stop-color="#f7c948" />
          <stop offset="1" stop-color="#e0a12b" />
        </linearGradient>
      </defs>
      <polygon points={points} fill="url(#seal-gold)" stroke="#c8871c" stroke-width="2.5" />
      <circle cx="100" cy="100" r="72" fill="none" stroke="#fff6d8" stroke-width="2.5" stroke-dasharray="5 4" />
      <path d="M40,58 Q95,18 160,55 L150,70 Q95,38 50,72 Z" fill="rgba(255,255,255,0.45)" />
      <text x="100" y="72" text-anchor="middle" font-size="26">✉️</text>
      <text class="seal-line" x="100" y="102" text-anchor="middle" font-size="19">GET PATCH</text>
      <text class="seal-line" x="100" y="124" text-anchor="middle" font-size="19">UPDATES!</text>
      <text class="seal-sub" x="100" y="148" text-anchor="middle" font-size="10.5">✦ tap to subscribe ✦</text>
    </svg>
    <span class="seal-twinkle" aria-hidden="true">✦</span>
  </button>

  <a
    class="seal-btn seal-companion seal-pink-btn"
    href={`${base}/guest-book/`}
    aria-label="Sign the guest book"
  >
    <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
      <defs>
        <linearGradient id="seal-pink" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffd6e7" />
          <stop offset="0.45" stop-color="#ff7eb6" />
          <stop offset="1" stop-color="#e93f8e" />
        </linearGradient>
      </defs>
      <polygon points={points} fill="url(#seal-pink)" stroke="#c2266f" stroke-width="2.5" />
      <circle cx="100" cy="100" r="72" fill="none" stroke="#fff0f6" stroke-width="2.5" stroke-dasharray="5 4" />
      <path d="M40,58 Q95,18 160,55 L150,70 Q95,38 50,72 Z" fill="rgba(255,255,255,0.4)" />
      <text x="100" y="72" text-anchor="middle" font-size="25">💌</text>
      <text class="seal-line pink" x="100" y="102" text-anchor="middle" font-size="18">SIGN THE</text>
      <text class="seal-line pink" x="100" y="123" text-anchor="middle" font-size="17">GUEST BOOK!</text>
      <text class="seal-sub pink" x="100" y="146" text-anchor="middle" font-size="10.5">✦ leave a card ✦</text>
    </svg>
    <span class="seal-twinkle t2" aria-hidden="true">✧</span>
  </a>

  <a
    class="seal-btn seal-companion seal-blurple-btn"
    href="https://discord.gg/rpyMtBqep"
    target="_blank"
    rel="noopener"
    aria-label="Join the Discord — geek out with like-minded fans"
  >
    <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
      <defs>
        <linearGradient id="seal-blurple" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#aab4ff" />
          <stop offset="0.45" stop-color="#5865f2" />
          <stop offset="1" stop-color="#3b45c4" />
        </linearGradient>
      </defs>
      <polygon points={points} fill="url(#seal-blurple)" stroke="#2f38a8" stroke-width="2.5" />
      <circle cx="100" cy="100" r="72" fill="none" stroke="#eef0ff" stroke-width="2.5" stroke-dasharray="5 4" />
      <path d="M40,58 Q95,18 160,55 L150,70 Q95,38 50,72 Z" fill="rgba(255,255,255,0.35)" />
      <text x="100" y="68" text-anchor="middle" font-size="24">💭</text>
      <text class="seal-line white" x="100" y="96" text-anchor="middle" font-size="13.5">GEEK OUT WITH</text>
      <text class="seal-line white" x="100" y="114" text-anchor="middle" font-size="13.5">LIKE-MINDED FANS!</text>
      <text class="seal-sub white" x="100" y="140" text-anchor="middle" font-size="10.5">✦ join the Discord ✦</text>
    </svg>
    <span class="seal-twinkle t3" aria-hidden="true">✦</span>
  </a>
</div>

<dialog class="sub-dialog" id="psub-dialog" aria-labelledby="psub-title">
  <div class="sub-banner">
    <div class="sub-glitter" aria-hidden="true">
      <span class="sub-star s1">✦</span>
      <span class="sub-star s2">✧</span>
      <span class="sub-star s3">✦</span>
      <span class="sub-star s4">✧</span>
    </div>
    <img class="sub-sprite" src={`${base}/decorations/quill-pen.png`} alt="" aria-hidden="true" />
    <button class="sub-close" id="psub-close" type="button" aria-label="Close">×</button>
    <h2 id="psub-title">Get an email when a new patch drops</h2>
    <p class="sub-lede">
      A short note whenever a new version of the English patch ships — what
      changed and where to grab it. That's the only thing your email is
      ever used for.
    </p>
  </div>

  <form class="sub-form" id="psub-form" novalidate>
    <div class="sub-row">
      <label class="visually-hidden" for="psub-email">Email address</label>
      <input
        id="psub-email"
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        maxlength="320"
        required
      />
      <button type="submit" id="psub-button">
        Subscribe <span aria-hidden="true">✦</span>
      </button>
    </div>
    <!-- Honeypot: bots fill it, people never see it. -->
    <label class="sub-hp" aria-hidden="true">
      Website (leave blank)
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <p class="sub-error" id="psub-error" hidden></p>
    <p class="sub-fine">
      Just release announcements — nothing else, ever.
      <button type="button" class="sub-mode-toggle" id="psub-mode">
        Want off the list? Unsubscribe here.
      </button>
    </p>
    <p class="sub-alt">
      Prefer a feed reader? There's an
      <a href={`${base}/feed.xml`}>RSS feed of patch releases</a> too.
    </p>
  </form>

  <div class="sub-done" id="psub-done" hidden>
    <span class="sub-done-emoji" aria-hidden="true">🎉</span>
    <p class="sub-done-text" id="psub-done-text">
      You're on the list! You'll hear from us when the next patch ships.
    </p>
  </div>
</dialog>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;

  const dialog = document.getElementById('psub-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('psub-open') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('psub-close') as HTMLButtonElement | null;
  const form = document.getElementById('psub-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('psub-email') as HTMLInputElement | null;
  const button = document.getElementById('psub-button') as HTMLButtonElement | null;
  const errorEl = document.getElementById('psub-error') as HTMLParagraphElement | null;
  const doneEl = document.getElementById('psub-done') as HTMLDivElement | null;
  const doneText = document.getElementById('psub-done-text') as HTMLParagraphElement | null;
  const modeToggle = document.getElementById('psub-mode') as HTMLButtonElement | null;

  // 'subscribe' | 'unsubscribe' — flipped by the small toggle link.
  let mode: 'subscribe' | 'unsubscribe' = 'subscribe';

  const RATE_KEY = 'tongari-sub-last';
  const RATE_WINDOW_MS = 60 * 1000;

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.hidden = true;
  }

  if (dialog && openBtn && closeBtn && form && emailInput && button && modeToggle) {
    openBtn.addEventListener('click', () => {
      dialog.showModal();
      emailInput.focus();
    });
    closeBtn.addEventListener('click', () => dialog.close());
    // Click on the backdrop (outside the dialog box) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Announcement emails link to …/patches/#subscribe for unsubscribing —
    // open the pop-up for them (on load, and when only the hash changes).
    function maybeOpenFromHash() {
      if (window.location.hash === '#subscribe' && !dialog!.open) {
        dialog!.showModal();
      }
    }
    maybeOpenFromHash();
    window.addEventListener('hashchange', maybeOpenFromHash);

    if (!SUPABASE_URL || !SUPABASE_KEY) {
      // Build without backend keys (e.g. local dev without .env): keep the
      // pop-up but explain the form is inert. The RSS link still works.
      emailInput.disabled = true;
      button.disabled = true;
      modeToggle.disabled = true;
      showError(
        "Email signup isn't wired up in this build — the RSS feed below still works."
      );
    }

    modeToggle.addEventListener('click', () => {
      if (modeToggle.disabled) return;
      mode = mode === 'subscribe' ? 'unsubscribe' : 'subscribe';
      button.childNodes[0].textContent =
        mode === 'subscribe' ? 'Subscribe ' : 'Unsubscribe ';
      modeToggle.textContent =
        mode === 'subscribe'
          ? 'Want off the list? Unsubscribe here.'
          : 'Changed your mind? Back to subscribing.';
      clearError();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();
      if (!SUPABASE_URL || !SUPABASE_KEY) return;

      const honeypot = (form.elements.namedItem('website') as HTMLInputElement | null)?.value;
      if (honeypot) return; // bot

      const email = emailInput.value.trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 320) {
        showError('That doesn’t look like an email address — double-check it?');
        return;
      }

      const last = Number(window.localStorage.getItem(RATE_KEY) || 0);
      if (Date.now() - last < RATE_WINDOW_MS) {
        showError('Give it a minute before submitting again.');
        return;
      }

      // Lock the mode for the whole request so a toggle click mid-flight
      // can't make the success state describe the wrong action.
      const submittedMode = mode;
      button.disabled = true;
      modeToggle.disabled = true;
      const submittingLabel = submittedMode === 'subscribe' ? 'Subscribing…' : 'Unsubscribing…';
      const restoreLabel = submittedMode === 'subscribe' ? 'Subscribe ' : 'Unsubscribe ';
      button.childNodes[0].textContent = submittingLabel;
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/patch_subscribers`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({ email, action: submittedMode }),
        });
        if (!res.ok) {
          throw new Error(`Signup failed (${res.status}). Try again in a bit?`);
        }
        window.localStorage.setItem(RATE_KEY, String(Date.now()));
        if (doneEl && doneText) {
          doneText.textContent =
            submittedMode === 'subscribe'
              ? "You're on the list! You'll hear from us when the next patch ships."
              : "You're off the list. No more emails — come back any time.";
          const emoji = doneEl.querySelector('.sub-done-emoji');
          if (emoji) emoji.textContent = submittedMode === 'subscribe' ? '🎉' : '👋';
          form.hidden = true;
          doneEl.hidden = false;
        }
      } catch (err: any) {
        showError(err?.message || 'Something went wrong — try again in a bit?');
        button.disabled = false;
        modeToggle.disabled = false;
        button.childNodes[0].textContent = restoreLabel;
      }
    });
  }
</script>

<style>
  /* ── The sticker cluster ──────────────────────────────────────── */
  .seal-cluster {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px;
    line-height: 0;
  }

  /* Keep the large cluster narrow enough to sit beside a page header:
     gold on top, the two companions tucked underneath. */
  .seal-cluster.seal-lg { max-width: 300px; }

  .seal-btn {
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: pointer;
    position: relative;
    display: inline-block;
    transform: rotate(-8deg);
    filter: drop-shadow(0 6px 12px rgba(200, 135, 28, 0.35));
    transition: transform 0.15s ease, filter 0.15s ease;
    text-decoration: none;
  }

  .seal-btn:hover,
  .seal-btn:focus-visible {
    transform: rotate(-3deg) scale(1.06);
    filter: drop-shadow(0 10px 18px rgba(200, 135, 28, 0.45));
  }

  .seal-btn:focus-visible {
    outline: 3px solid var(--color-purple-400);
    outline-offset: 4px;
  }

  .seal-pink-btn {
    transform: rotate(6deg);
    filter: drop-shadow(0 6px 12px rgba(233, 63, 142, 0.35));
  }

  .seal-pink-btn:hover,
  .seal-pink-btn:focus-visible {
    transform: rotate(2deg) scale(1.06);
    filter: drop-shadow(0 10px 18px rgba(233, 63, 142, 0.45));
  }

  .seal-blurple-btn {
    transform: rotate(-5deg);
    filter: drop-shadow(0 6px 12px rgba(88, 101, 242, 0.4));
  }

  .seal-blurple-btn:hover,
  .seal-blurple-btn:focus-visible {
    transform: rotate(-1deg) scale(1.06);
    filter: drop-shadow(0 10px 18px rgba(88, 101, 242, 0.5));
  }

  .seal-lg .seal-btn svg { width: 150px; height: 150px; }
  .seal-lg .seal-companion svg { width: 128px; height: 128px; }
  .seal-md .seal-btn svg { width: 112px; height: 112px; }
  .seal-md .seal-companion svg { width: 100px; height: 100px; }

  .seal-line {
    font-family: var(--font-display);
    font-weight: 700;
    fill: #7a4d12;
    letter-spacing: 0.04em;
  }

  .seal-sub {
    font-family: var(--font-display);
    font-weight: 700;
    fill: #9a6a1f;
    letter-spacing: 0.03em;
  }

  .seal-line.pink { fill: #8a1150; }
  .seal-sub.pink  { fill: #a8266b; }
  .seal-line.white { fill: #ffffff; }
  .seal-sub.white  { fill: #dfe3ff; }

  .seal-twinkle {
    position: absolute;
    top: 4px;
    right: 2px;
    color: #fff6d8;
    text-shadow: 0 0 6px rgba(247, 201, 72, 0.9);
    font-size: 1rem;
    animation: seal-twinkle 2.4s ease-in-out infinite;
    pointer-events: none;
  }

  .seal-twinkle.t2 {
    color: #fff0f6;
    text-shadow: 0 0 6px rgba(255, 126, 182, 0.9);
    animation-delay: 0.8s;
  }

  .seal-twinkle.t3 {
    color: #eef0ff;
    text-shadow: 0 0 6px rgba(88, 101, 242, 0.9);
    animation-delay: 1.5s;
  }

  @keyframes seal-twinkle {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50%      { opacity: 1;   transform: scale(1.2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .seal-btn { transition: none; }
    .seal-twinkle { animation: none; }
  }

  /* ── The pop-up ───────────────────────────────────────────────── */
  .sub-dialog {
    width: min(480px, calc(100vw - 40px));
    padding: 0 0 20px;
    border: 1.5px solid transparent;
    border-radius: var(--radius-lg);
    background: var(--surface-strong);
    background-image:
      linear-gradient(var(--surface-strong), var(--surface-strong)),
      linear-gradient(120deg, var(--color-pink-200), var(--color-purple-200), var(--color-blue-200));
    background-origin: border-box;
    background-clip: padding-box, border-box;
    box-shadow: 0 24px 64px rgba(74, 46, 94, 0.35);
    color: var(--color-ink);
    overflow: hidden;
  }

  .sub-dialog::backdrop {
    background: rgba(74, 46, 94, 0.55);
    backdrop-filter: blur(5px);
  }

  .sub-banner {
    position: relative;
    padding: 24px 26px 18px;
    background:
      linear-gradient(120deg,
        var(--color-pink-100) 0%,
        var(--color-purple-100) 48%,
        var(--color-blue-100) 100%);
    border-bottom: 1px solid var(--color-purple-100);
  }

  .sub-banner h2 {
    margin: 0 46px 8px 0;
    font-size: 1.3rem;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .sub-lede {
    margin: 0;
    line-height: 1.55;
    color: var(--color-ink);
    font-size: 0.92rem;
    max-width: 48ch;
  }

  .sub-sprite {
    position: absolute;
    top: -8px;
    right: 40px;
    width: 54px;
    height: 54px;
    pointer-events: none;
    user-select: none;
    transform: rotate(-8deg);
    filter: drop-shadow(0 4px 8px rgba(109, 76, 166, 0.25));
  }

  .sub-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--color-pink-200);
    background: white;
    color: var(--color-pink-600);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
  }

  .sub-close:hover {
    background: var(--color-pink-100);
  }

  .sub-glitter {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .sub-star {
    position: absolute;
    color: white;
    text-shadow: 0 0 6px rgba(255, 126, 182, 0.7);
    opacity: 0.85;
    animation: sub-twinkle 3s ease-in-out infinite;
  }

  .sub-star.s1 { top: 16%;  left: 6%;   font-size: 0.85rem; animation-delay: 0s;    color: var(--color-pink-200); }
  .sub-star.s2 { top: 66%;  left: 14%;  font-size: 0.7rem;  animation-delay: 0.6s;  color: white; }
  .sub-star.s3 { top: 22%;  left: 58%;  font-size: 0.75rem; animation-delay: 1.1s;  color: var(--color-blue-200); }
  .sub-star.s4 { top: 70%;  left: 72%;  font-size: 0.9rem;  animation-delay: 0.3s;  color: white; }

  @keyframes sub-twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50%      { opacity: 1;    transform: scale(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sub-star { animation: none; }
  }

  .sub-form {
    margin: 18px 26px 0;
  }

  .sub-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .sub-row input[type='email'] {
    flex: 1;
    min-width: 180px;
    padding: 11px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-purple-200);
    background: white;
    color: var(--color-ink);
    font: inherit;
    box-shadow: var(--shadow-soft);
  }

  .sub-row input[type='email']:focus {
    border-color: var(--color-purple-400);
    outline: none;
    box-shadow: 0 0 0 3px var(--color-purple-100);
  }

  .sub-row input[type='email']:disabled {
    opacity: 0.6;
    background: var(--color-purple-50);
  }

  .sub-row button {
    padding: 11px 22px;
    border-radius: var(--radius-pill);
    border: none;
    background: linear-gradient(135deg, var(--color-pink-400), var(--color-purple-400));
    color: white;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    box-shadow: var(--shadow-pop);
    transition: transform 0.12s ease;
  }

  .sub-row button:not(:disabled):hover {
    transform: translateY(-2px);
  }

  .sub-row button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .sub-hp {
    position: absolute;
    left: -9999px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .sub-error {
    margin: 10px 0 0;
    color: var(--color-pink-600);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .sub-fine {
    margin: 12px 0 0;
    color: var(--color-ink-soft);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .sub-mode-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    font-size: 0.82rem;
    color: var(--color-purple-400);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-style: dotted;
    cursor: pointer;
  }

  .sub-mode-toggle:hover {
    color: var(--color-purple-600);
  }

  /* The hidden attribute only wins if no author rule sets display, so the
     flex layout must not apply while [hidden] is present. */
  .sub-done[hidden] {
    display: none;
  }

  .sub-done {
    margin: 20px 26px 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: linear-gradient(135deg, var(--color-pink-50), var(--color-purple-50));
    border: 1px solid var(--color-pink-100);
    border-radius: var(--radius-md);
  }

  .sub-done-emoji {
    font-size: 1.6rem;
  }

  .sub-done-text {
    margin: 0;
    color: var(--color-ink);
    font-weight: 600;
    line-height: 1.5;
  }

  .sub-alt {
    margin: 12px 0 0;
    color: var(--color-ink-soft);
    font-size: 0.82rem;
  }

  .sub-alt a {
    color: var(--color-purple-400);
