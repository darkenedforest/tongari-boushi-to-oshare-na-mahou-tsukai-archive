---
// A game card drawn in SVG: the cartridge shell (dark grey for DS, white
// for 3DS, with the 3DS card's tab on the top-right), ridged grip, and a
// label carrying the game's own icon (pixel art, scaled crisp) and title.
// Tilted and given the site's hard drop shadow by the caller's class.
import { GAMES, type GameId } from '../data/games';

interface Props {
  game: GameId;
  /** Rendered width in px; height follows the 140×150 view box. */
  width?: number;
  /** Rotation in degrees. */
  tilt?: number;
  class?: string;
}

const { game, width = 150, tilt = 0, class: cls = '' } = Astro.props;
const g = GAMES[game];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const uid = `cart-${game}-${Math.random().toString(36).slice(2, 8)}`;
const is3ds = game === '3ds';
const titleLines = is3ds ? ['とんがりボウシと', '魔法の町'] : ['とんがりボウシと', 'おしゃれなまほうつかい'];
---

<svg
  class={`game-cart ${cls}`}
  viewBox="0 0 140 150"
  width={width}
  height={Math.round((width * 150) / 140)}
  style={`--tilt:${tilt}deg`}
  role="img"
  aria-label={`${g.platform} game card: ${g.titleJa}`}
>
  <defs>
    <linearGradient id={`${uid}-label`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={g.accent.light} />
      <stop offset="1" stop-color="#ffffff" />
    </linearGradient>
    <linearGradient id={`${uid}-band`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color={g.accent.deep} />
      <stop offset="1" stop-color={g.accent.mid} />
    </linearGradient>
    <linearGradient id={`${uid}-sheen`} x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity={is3ds ? 0.6 : 0.18} />
      <stop offset="0.45" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
    <clipPath id={`${uid}-labelclip`}>
      <rect x="21" y="40" width="98" height="96" rx="4" />
    </clipPath>
  </defs>

  {/* shell */}
  {is3ds && <rect x="103" y="4" width="20" height="12" rx="2" fill={g.cart.body} stroke={g.cart.edge} stroke-width="2" />}
  <path
    d="M16 10 H124 a6 6 0 0 1 6 6 V140 a6 6 0 0 1 -6 6 H22 L10 134 V16 a6 6 0 0 1 6 -6 Z"
    fill={g.cart.body}
    stroke={g.cart.edge}
    stroke-width="2.5"
    stroke-linejoin="round"
  />
  {/* grip ridges */}
  {[0, 1, 2, 3, 4, 5].map((i) => (
    <rect x="30" y={15 + i * 3.6} width="80" height="1.8" rx="0.9" fill={g.cart.ridge} />
  ))}

  {/* label */}
  <rect x="21" y="40" width="98" height="96" rx="4" fill={`url(#${uid}-label)`} />
  <g clip-path={`url(#${uid}-labelclip)`}>
    <rect x="21" y="40" width="98" height="13" fill={`url(#${uid}-band)`} />
    <text x="27" y="49.5" font-family="var(--font-display)" font-size="8" font-weight="700" fill="#ffffff" letter-spacing="0.5">
      {g.platform}
    </text>
    <text x="113" y="49.5" text-anchor="end" font-family="var(--font-display)" font-size="5.5" fill="#ffffff" opacity="0.9">
      ✦ ENGLISH
    </text>
    <image
      href={`${base}${g.icon}`}
      x="42"
      y="56"
      width="56"
      height="56"
      style="image-rendering: pixelated; image-rendering: crisp-edges;"
      preserveAspectRatio="xMidYMid meet"
    />
    <text x="70" y="121" text-anchor="middle" font-family="var(--font-body)" font-size="7" fill={g.accent.ink}>
      {titleLines[0]}
    </text>
    <text x="70" y="130" text-anchor="middle" font-family="var(--font-body)" font-size={titleLines[1].length > 6 ? 6.4 : 8} fill={g.accent.ink}>
      {titleLines[1]}
    </text>
  </g>
  <rect x="21" y="40" width="98" height="96" rx="4" fill="none" stroke={g.cart.edge} stroke-opacity="0.35" />

  {/* plastic sheen */}
  <path
    d="M16 10 H124 a6 6 0 0 1 6 6 V140 a6 6 0 0 1 -6 6 H22 L10 134 V16 a6 6 0 0 1 6 -6 Z"
    fill={`url(#${uid}-sheen)`}
    pointer-events="none"
  />
</svg>

<style>
  .game-cart {
    display: block;
    transform: rotate(var(--tilt));
    filter: drop-shadow(5px 6px 0 rgba(74, 46, 94, 0.28));
    transition: transform 0.2s ease;
    overflow: visible;
  }
</style>
