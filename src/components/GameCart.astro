---
// A game card drawn in SVG, shaped after the real cards: small rounded
// corners with one large rounded corner at the bottom left, a recessed
// label (white header band, art panel with its two corner notches, white
// strip carrying the product code), and per platform:
//   DS  — dark grey shell, the insert arrow below the label;
//   3DS — white shell, the tab on the right side near the top.
// The label shows the game's own icon (pixel art, scaled crisp) and title.
// Tilted and given the site's hard drop shadow by the caller.
import { GAMES, type GameId } from '../data/games';

interface Props {
  game: GameId;
  /** Rendered width in px; height follows the 140×150 view box. */
  width?: number;
  /** Rotation in degrees. */
  tilt?: number;
  class?: string;
}

const { game, width = 150, tilt = 0, class: cls = '' } = Astro.props;
const g = GAMES[game];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const uid = `cart-${game}-${Math.random().toString(36).slice(2, 8)}`;
const is3ds = game === '3ds';
const titleLines = is3ds ? ['とんがりボウシと', '魔法の町'] : ['とんがりボウシと', 'おしゃれなまほうつかい'];

// Shell geometry (real cards are 33 × 35 mm).
const T = 9;                     // top
const B = 141;                   // bottom
const L = is3ds ? 5 : 8;         // left
const R = is3ds ? 127 : 132;     // right edge of the main body
const r = 6;                     // small corner radius
const rb = 22;                   // large bottom-left radius
const tabR = R + 6;              // 3DS tab: outer edge
const tabB = T + 34;             //          bottom of the tab

const shell = is3ds
  ? `M${L + r} ${T} H${tabR - r} A${r} ${r} 0 0 1 ${tabR} ${T + r} V${tabB - 3} ` +
    `Q${tabR} ${tabB} ${tabR - 3} ${tabB} H${R + 2} Q${R} ${tabB} ${R} ${tabB + 2} ` +
    `V${B - r} A${r} ${r} 0 0 1 ${R - r} ${B} H${L + rb} A${rb} ${rb} 0 0 1 ${L} ${B - rb} ` +
    `V${T + r} A${r} ${r} 0 0 1 ${L + r} ${T} Z`
  : `M${L + r} ${T} H${R - r} A${r} ${r} 0 0 1 ${R} ${T + r} V${B - r} ` +
    `A${r} ${r} 0 0 1 ${R - r} ${B} H${L + rb} A${rb} ${rb} 0 0 1 ${L} ${B - rb} ` +
    `V${T + r} A${r} ${r} 0 0 1 ${L + r} ${T} Z`;

// Label recess and sticker.
const xL = L + 9;                // recess left
const xR = R - 9;                // recess right
const yT = T + 6;                // recess top
const yB = is3ds ? B - 12 : B - 21; // recess bottom (DS leaves room for the arrow)
const ch = 7;                    // bottom-left chamfer of the recess
const recess =
  `M${xL + 3} ${yT} H${xR - 3} Q${xR} ${yT} ${xR} ${yT + 3} V${yB} H${xL + ch} L${xL} ${yB - ch} ` +
  `V${yT + 3} Q${xL} ${yT} ${xL + 3} ${yT} Z`;

const sL = xL + 2;               // sticker inset
const sR = xR - 2;
const headT = yT + 2;
const headB = headT + 13;
const artT = headB + 2;
const stripB = yB - 2;
const stripT = stripB - 10;
const artB = stripT - 2;
const notch =
  `M${sL} ${artT + 4} H${sL + 5} L${sL + 7} ${artT} H${sR - 7} L${sR - 5} ${artT + 4} H${sR} ` +
  `V${artB} H${sL} Z`;
const strip = `M${sL} ${stripT} H${sR} V${stripB} H${sL + ch - 2} L${sL} ${stripB - ch + 2} Z`;

const cx = (sL + sR) / 2;
const iconSize = 42;
const iconY = artT + 6;
const title1Y = iconY + iconSize + 9;
const title2Y = title1Y + 8.5;
---

<svg
  class={`game-cart ${cls}`}
  viewBox="0 0 140 150"
  width={width}
  height={Math.round((width * 150) / 140)}
  style={`--tilt:${tilt}deg`}
  role="img"
  aria-label={`${g.platform} game card: ${g.titleJa}`}
>
  <defs>
    <linearGradient id={`${uid}-art`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={g.accent.light} />
      <stop offset="1" stop-color="#ffffff" />
    </linearGradient>
    <linearGradient id={`${uid}-sheen`} x1="0" y1="0" x2="0.7" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity={is3ds ? 0.55 : 0.16} />
      <stop offset="0.5" stop-color="#ffffff" stop-opacity="0" />
    </linearGradient>
  </defs>

  {/* shell */}
  <path d={shell} fill={g.cart.body} stroke={g.cart.edge} stroke-width="2.2" stroke-linejoin="round" />
  {/* raised rim just inside the edge */}
  <path d={shell} fill="none" stroke={is3ds ? '#ffffff' : g.cart.ridge} stroke-width="1.2" opacity="0.8"
        transform={`translate(${(L + R) / 2} ${(T + B) / 2}) scale(0.94 0.95) translate(${-(L + R) / 2} ${-(T + B) / 2})`} />

  {/* label recess */}
  <path d={recess} fill={g.cart.edge} opacity={is3ds ? 0.55 : 0.9} />

  {/* header band */}
  <rect x={sL} y={headT} width={sR - sL} height={headB - headT} rx="2" fill="#ffffff" />
  <text x={sL + 5} y={headB - 3.6} font-family="var(--font-display)" font-size="8.5" font-weight="700"
        fill={g.accent.deep} letter-spacing="0.4">{g.platform}</text>
  <text x={sR - 4} y={headB - 4.2} text-anchor="end" font-family="var(--font-display)" font-size="5"
        fill={g.accent.deep} opacity="0.85">{g.cartTag}</text>

  {/* art panel with its corner notches */}
  <path d={notch} fill={`url(#${uid}-art)`} />
  <image
    href={`${base}${g.icon}`}
    x={cx - iconSize / 2}
    y={iconY}
    width={iconSize}
    height={iconSize}
    style="image-rendering: pixelated; image-rendering: crisp-edges;"
    preserveAspectRatio="xMidYMid meet"
  />
  <text x={cx} y={title1Y} text-anchor="middle" font-family="var(--font-body)" font-size="6.6" fill={g.accent.ink}>
    {titleLines[0]}
  </text>
  <text x={cx} y={title2Y} text-anchor="middle" font-family="var(--font-body)"
        font-size={titleLines[1].length > 6 ? 6 : 7.6} fill={g.accent.ink}>
    {titleLines[1]}
  </text>

  {/* bottom strip with the product code */}
  <path d={strip} fill="#ffffff" />
  <text x={sR - 4} y={stripB - 3.2} text-anchor="end" font-family="var(--font-body)" font-size="4.6"
        fill="#55505e" letter-spacing="0.3">{g.productCode}</text>

  {/* DS: insert arrow below the label */}
  {!is3ds && (
    <path d={`M${cx - 6} ${B - 13} H${cx + 6} L${cx} ${B - 7} Z`} fill={g.cart.edge} />
  )}

  {/* plastic sheen */}
  <path d={shell} fill={`url(#${uid}-sheen)`} pointer-events="none" />
</svg>

<style>
  .game-cart {
    display: block;
    transform: rotate(var(--tilt));
    filter: drop-shadow(5px 6px 0 rgba(74, 46, 94, 0.28));
    transition: transform 0.2s ease;
    overflow: visible;
  }
</style>
