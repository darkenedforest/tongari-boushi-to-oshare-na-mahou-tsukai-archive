---
// Homepage badges, placed independently: part="sticker" renders the pink
// "Sign the guest book!" sticker (sits beside the hero title); part
// ="discord" renders the official Discord badge (blurple pill, official
// white logo) with the tagline underneath (sits below the hero lede).
// The mailing-list seal intentionally stays off the homepage — it lives
// on Patches and Changelog via SubscribeSeal.
interface Props {
  part: 'sticker' | 'discord';
}
const { part } = Astro.props;
const base = import.meta.env.BASE_URL;

// Starburst sticker outline: 24 spikes on a 200x200 viewBox (same shape
// family as SubscribeSeal's stickers).
const points = Array.from({ length: 48 }, (_, i) => {
  const r = i % 2 === 0 ? 98 : 87;
  const a = (Math.PI * 2 * i) / 48 - Math.PI / 2;
  return `${(100 + r * Math.cos(a)).toFixed(2)},${(100 + r * Math.sin(a)).toFixed(2)}`;
}).join(' ');

---

{part === 'sticker' && (
  <a
    class="hb-sticker"
    href={`${base}/guest-book/`}
    aria-label="Sign the guest book"
  >
    <svg viewBox="0 0 200 200" role="presentation" aria-hidden="true">
      <defs>
        <linearGradient id="hb-pink" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffd6e7" />
          <stop offset="0.45" stop-color="#ff7eb6" />
          <stop offset="1" stop-color="#e93f8e" />
        </linearGradient>
      </defs>
      <polygon points={points} fill="url(#hb-pink)" stroke="#c2266f" stroke-width="2.5" />
      <circle cx="100" cy="100" r="72" fill="none" stroke="#fff0f6" stroke-width="2.5" stroke-dasharray="5 4" />
      <path d="M40,58 Q95,18 160,55 L150,70 Q95,38 50,72 Z" fill="rgba(255,255,255,0.4)" />
      <text x="100" y="72" text-anchor="middle" font-size="25">💌</text>
      <text class="hb-line" x="100" y="102" text-anchor="middle" font-size="18">SIGN THE</text>
      <text class="hb-line" x="100" y="123" text-anchor="middle" font-size="17">GUEST BOOK!</text>
      <text class="hb-sub" x="100" y="146" text-anchor="middle" font-size="10.5">✦ leave a card ✦</text>
    </svg>
    <span class="hb-twinkle" aria-hidden="true">✧</span>
  </a>
)}

{part === 'discord' && (
  <a
    class="hb-discord"
    href="https://discord.gg/rpyMtBqep"
    target="_blank"
    rel="noopener"
    aria-label="Join the Discord — geek out with like-minded fans"
  >
    <span class="hb-discord-pill" style="border-radius: 26px !important;">
      <img
        src={`${base}/badges/discord-logo-white.svg`}
        alt=""
        aria-hidden="true"
        width="172"
        height="26"
      />
    </span>
    <span class="hb-discord-tag">Geek out with like-minded fans! ✦</span>
  </a>
)}

<style>
  .hb-sticker {
    position: relative;
    display: inline-block;
    line-height: 0;
    transform: rotate(-6deg);
    filter: drop-shadow(0 6px 12px rgba(233, 63, 142, 0.35));
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .hb-sticker:hover,
  .hb-sticker:focus-visible {
    transform: rotate(-2deg) scale(1.06);
    filter: drop-shadow(0 10px 18px rgba(233, 63, 142, 0.45));
  }

  .hb-sticker:focus-visible {
    outline: 3px solid var(--color-purple-400);
    outline-offset: 4px;
  }

  .hb-sticker svg {
    width: 142px;
    height: 142px;
  }

  .hb-line {
    font-family: var(--font-display);
    font-weight: 700;
    fill: #8a1150;
    letter-spacing: 0.04em;
  }

  .hb-sub {
    font-family: var(--font-display);
    font-weight: 700;
    fill: #a8266b;
    letter-spacing: 0.03em;
  }

  .hb-twinkle {
    position: absolute;
    top: 4px;
    right: 2px;
    color: #fff0f6;
    text-shadow: 0 0 6px rgba(255, 126, 182, 0.9);
    font-size: 1rem;
    animation: hb-twinkle 2.4s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes hb-twinkle {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50%      { opacity: 1;   transform: scale(1.2); }
  }

  .hb-discord {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .hb-discord:hover,
  .hb-discord:focus-visible {
    transform: translateY(-3px);
  }

  .hb-discord:focus-visible {
    outline: 3px solid var(--color-purple-400);
    outline-offset: 4px;
  }

  .hb-discord-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    background: #5865f2;
    box-shadow: 0 6px 14px rgba(88, 101, 242, 0.45);
    transition: box-shadow 0.15s ease;
  }

  .hb-discord:hover .hb-discord-pill {
    box-shadow: 0 12px 26px rgba(88, 101, 242, 0.55);
  }

  .hb-discord-pill img {
    display: block;
    height: 17px;
    width: auto;
  }

  .hb-discord-tag {
    color: var(--color-ink-soft);
    font-weight: 600;
    font-size: 0.8rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hb-sticker,
    .hb-discord { transition: none; }
    .hb-twinkle { animation: none; }
  }
</style>
