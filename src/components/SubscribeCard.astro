---
// Subscribe-for-patch-updates card. Collects an email into the Supabase
// `patch_subscribers` table (insert-only via the anon key — the table is
// not readable from the browser, see SUPABASE_SETUP.md). Announcements are
// sent by scripts/send_patch_announcement.py when a release ships.
const base = import.meta.env.BASE_URL;
---

<section class="sub-card" id="subscribe" aria-labelledby="sub-title">
  <div class="sub-banner">
    <div class="sub-glitter" aria-hidden="true">
      <span class="sub-star s1">✦</span>
      <span class="sub-star s2">✧</span>
      <span class="sub-star s3">✦</span>
      <span class="sub-star s4">✧</span>
      <span class="sub-star s5">✦</span>
    </div>
    <img
      class="sub-sprite"
      src={`${base}/decorations/quill-pen.png`}
      alt=""
      aria-hidden="true"
    />
    <div class="sub-header">
      <span class="sub-chip">
        <span class="sub-chip-star" aria-hidden="true">✦</span> Never miss a release
      </span>
      <h2 id="sub-title">Get an email when a new patch drops</h2>
      <p class="sub-lede">
        Leave your email and you'll get a short note whenever a new version of
        the English patch ships — what changed and where to grab it. That's
        the only thing it's ever used for.
      </p>
    </div>
  </div>

  <form class="sub-form" id="psub-form" novalidate>
    <div class="sub-row">
      <label class="visually-hidden" for="psub-email">Email address</label>
      <input
        id="psub-email"
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        maxlength="320"
        required
      />
      <button type="submit" id="psub-button">
        Subscribe <span aria-hidden="true">✦</span>
      </button>
    </div>
    <!-- Honeypot: bots fill it, people never see it. -->
    <label class="sub-hp" aria-hidden="true">
      Website (leave blank)
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
    <p class="sub-error" id="psub-error" hidden></p>
    <p class="sub-fine">
      Just release announcements — nothing else, ever.
      <button type="button" class="sub-mode-toggle" id="psub-mode">
        Want off the list? Unsubscribe here.
      </button>
    </p>
  </form>

  <div class="sub-done" id="psub-done" hidden>
    <span class="sub-done-emoji" aria-hidden="true">🎉</span>
    <p class="sub-done-text" id="psub-done-text">
      You're on the list! You'll hear from us when the next patch ships.
    </p>
  </div>

  <p class="sub-alt">
    Prefer a feed reader? There's an
    <a href={`${base}/feed.xml`}>RSS feed of patch releases</a> too.
  </p>
</section>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;

  const form = document.getElementById('psub-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('psub-email') as HTMLInputElement | null;
  const button = document.getElementById('psub-button') as HTMLButtonElement | null;
  const errorEl = document.getElementById('psub-error') as HTMLParagraphElement | null;
  const doneEl = document.getElementById('psub-done') as HTMLDivElement | null;
  const doneText = document.getElementById('psub-done-text') as HTMLParagraphElement | null;
  const modeToggle = document.getElementById('psub-mode') as HTMLButtonElement | null;

  // 'subscribe' | 'unsubscribe' — flipped by the small toggle link.
  let mode: 'subscribe' | 'unsubscribe' = 'subscribe';

  const RATE_KEY = 'tongari-sub-last';
  const RATE_WINDOW_MS = 60 * 1000;

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.hidden = true;
  }

  if (form && emailInput && button && modeToggle) {
    if (!SUPABASE_URL || !SUPABASE_KEY) {
      // Build without backend keys (e.g. local dev without .env): keep the
      // card but explain the form is inert. The RSS link still works.
      emailInput.disabled = true;
      button.disabled = true;
      modeToggle.disabled = true;
      showError(
        "Email signup isn't wired up in this build — the RSS feed below still works."
      );
    }

    modeToggle.addEventListener('click', () => {
      if (modeToggle.disabled) return;
      mode = mode === 'subscribe' ? 'unsubscribe' : 'subscribe';
      button.childNodes[0].textContent =
        mode === 'subscribe' ? 'Subscribe ' : 'Unsubscribe ';
      modeToggle.textContent =
        mode === 'subscribe'
          ? 'Want off the list? Unsubscribe here.'
          : 'Changed your mind? Back to subscribing.';
      clearError();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError();
      if (!SUPABASE_URL || !SUPABASE_KEY) return;

      const honeypot = (form.elements.namedItem('website') as HTMLInputElement | null)?.value;
      if (honeypot) return; // bot

      const email = emailInput.value.trim().toLowerCase();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 320) {
        showError('That doesn’t look like an email address — double-check it?');
        return;
      }

      const last = Number(window.localStorage.getItem(RATE_KEY) || 0);
      if (Date.now() - last < RATE_WINDOW_MS) {
        showError('Give it a minute before submitting again.');
        return;
      }

      // Lock the mode for the whole request so a toggle click mid-flight
      // can't make the success state describe the wrong action.
      const submittedMode = mode;
      button.disabled = true;
      modeToggle.disabled = true;
      const submittingLabel = submittedMode === 'subscribe' ? 'Subscribing…' : 'Unsubscribing…';
      const restoreLabel = submittedMode === 'subscribe' ? 'Subscribe ' : 'Unsubscribe ';
      button.childNodes[0].textContent = submittingLabel;
      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/patch_subscribers`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_KEY,
            Authorization: `Bearer ${SUPABASE_KEY}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({ email, action: submittedMode }),
        });
        if (!res.ok) {
          throw new Error(`Signup failed (${res.status}). Try again in a bit?`);
        }
        window.localStorage.setItem(RATE_KEY, String(Date.now()));
        if (doneEl && doneText) {
          doneText.textContent =
            submittedMode === 'subscribe'
              ? "You're on the list! You'll hear from us when the next patch ships."
              : "You're off the list. No more emails — come back any time.";
          const emoji = doneEl.querySelector('.sub-done-emoji');
          if (emoji) emoji.textContent = submittedMode === 'subscribe' ? '🎉' : '👋';
          form.hidden = true;
          doneEl.hidden = false;
        }
      } catch (err: any) {
        showError(err?.message || 'Something went wrong — try again in a bit?');
        button.disabled = false;
        modeToggle.disabled = false;
        button.childNodes[0].textContent = restoreLabel;
      }
    });
  }
</script>

<style>
  .sub-card {
    margin: 28px 0 36px;
    padding: 0 0 22px;
    background: var(--surface-strong);
    border: 1.5px solid transparent;
    border-radius: var(--radius-lg);
    background-image:
      linear-gradient(var(--surface-strong), var(--surface-strong)),
      linear-gradient(120deg, var(--color-pink-200), var(--color-purple-200), var(--color-blue-200));
    background-origin: border-box;
    background-clip: padding-box, border-box;
    box-shadow: var(--shadow-pop);
    position: relative;
    overflow: hidden;
  }

  .sub-banner {
    position: relative;
    padding: 26px 30px 22px;
    background:
      radial-gradient(circle at 88% 18%, rgba(255, 255, 255, 0.55) 0 2px, transparent 3px),
      radial-gradient(circle at 70% 60%, rgba(255, 255, 255, 0.45) 0 1.5px, transparent 2.5px),
      linear-gradient(120deg,
        var(--color-pink-100) 0%,
        var(--color-purple-100) 48%,
        var(--color-blue-100) 100%);
    border-bottom: 1px solid var(--color-purple-100);
    overflow: hidden;
  }

  .sub-header {
    position: relative;
    z-index: 2;
  }

  .sub-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    margin-bottom: 10px;
    background: rgba(255, 255, 255, 0.85);
    color: var(--color-purple-600);
    border: 1px solid var(--color-pink-200);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(2px);
  }

  .sub-chip-star {
    color: var(--color-pink-400);
    animation: sub-twinkle 2.4s ease-in-out infinite;
  }

  .sub-header h2 {
    margin: 0 0 8px;
    font-size: 1.45rem;
    letter-spacing: 0.01em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .sub-lede {
    max-width: 58ch;
    margin: 0;
    line-height: 1.6;
    color: var(--color-ink);
  }

  .sub-sprite {
    position: absolute;
    top: -10px;
    right: 22px;
    width: 76px;
    height: 76px;
    z-index: 1;
    pointer-events: none;
    user-select: none;
    transform: rotate(-8deg);
    filter: drop-shadow(0 6px 10px rgba(109, 76, 166, 0.25));
    animation: sub-float 5s ease-in-out infinite;
  }

  .sub-glitter {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .sub-star {
    position: absolute;
    color: white;
    text-shadow: 0 0 6px rgba(255, 126, 182, 0.7);
    opacity: 0.85;
    animation: sub-twinkle 3s ease-in-out infinite;
  }

  .sub-star.s1 { top: 18%;  left: 6%;   font-size: 0.9rem;  animation-delay: 0s;    color: var(--color-pink-200); }
  .sub-star.s2 { top: 66%;  left: 18%;  font-size: 0.7rem;  animation-delay: 0.6s;  color: white; }
  .sub-star.s3 { top: 26%;  left: 48%;  font-size: 0.8rem;  animation-delay: 1.1s;  color: var(--color-blue-200); }
  .sub-star.s4 { top: 70%;  left: 60%;  font-size: 1rem;    animation-delay: 0.3s;  color: white; }
  .sub-star.s5 { top: 30%;  left: 78%;  font-size: 0.75rem; animation-delay: 1.5s;  color: var(--color-purple-200); }

  @keyframes sub-twinkle {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50%      { opacity: 1;    transform: scale(1.15); }
  }

  @keyframes sub-float {
    0%, 100% { transform: rotate(-8deg) translateY(0); }
    50%      { transform: rotate(-5deg) translateY(-6px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sub-star,
    .sub-chip-star,
    .sub-sprite { animation: none; }
  }

  .sub-form {
    margin: 20px 30px 0;
  }

  .sub-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    max-width: 560px;
  }

  .sub-row input[type='email'] {
    flex: 1;
    min-width: 220px;
    padding: 12px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-purple-200);
    background: white;
    color: var(--color-ink);
    font: inherit;
    box-shadow: var(--shadow-soft);
  }

  .sub-row input[type='email']:focus {
    border-color: var(--color-purple-400);
    outline: none;
    box-shadow: 0 0 0 3px var(--color-purple-100);
  }

  .sub-row input[type='email']:disabled {
    opacity: 0.6;
    background: var(--color-purple-50);
  }

  .sub-row button {
    padding: 12px 26px;
    border-radius: var(--radius-pill);
    border: none;
    background: linear-gradient(135deg, var(--color-pink-400), var(--color-purple-400));
    color: white;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    cursor: pointer;
    box-shadow: var(--shadow-pop);
    transition: transform 0.12s ease, box-shadow 0.15s ease;
  }

  .sub-row button:not(:disabled):hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(233, 63, 142, 0.3);
  }

  .sub-row button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .sub-hp {
    position: absolute;
    left: -9999px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .sub-error {
    margin: 10px 0 0;
    color: var(--color-pink-600);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .sub-fine {
    margin: 12px 0 0;
    color: var(--color-ink-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .sub-mode-toggle {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    font-size: 0.85rem;
    color: var(--color-purple-400);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-style: dotted;
    cursor: pointer;
  }

  .sub-mode-toggle:hover {
    color: var(--color-purple-600);
  }

  /* The hidden attribute only wins if no author rule sets display, so the
     flex layout must not apply while [hidden] is present. */
  .sub-done[hidden] {
    display: none;
  }

  .sub-done {
    margin: 22px 30px 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: linear-gradient(135deg, var(--color-pink-50), var(--color-purple-50));
    border: 1px solid var(--color-pink-100);
    border-radius: var(--radius-md);
  }

  .sub-done-emoji {
    font-size: 1.8rem;
  }

  .sub-done-text {
    margin: 0;
    color: var(--color-ink);
    font-weight: 600;
    line-height: 1.5;
  }

  .sub-alt {
    margin: 16px 30px 0;
    color: var(--color-ink-soft);
    font-size: 0.85rem;
  }

  .sub-alt a {
    color: var(--color-purple-400);
    font-weight: 600;
  }

  @media (max-width: 560px) {
    .sub-banner {
      padding: 22px 20px 18px;
    }
    .sub-form,
    .sub-done,
    .sub-alt {
      margin-left: 20px;
      margin-right: 20px;
    }
    .sub-sprite {
      width: 56px;
      height: 56px;
      right: 12px;
    }
  }
</style>
